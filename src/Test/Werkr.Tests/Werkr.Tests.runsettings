<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <MSTest>
    <!-- Run integration tests sequentially — they share a single AppHost instance -->
    <Parallelize>
      <Workers>1</Workers>
      <Scope>ClassLevel</Scope>
    </Parallelize>
  </MSTest>
  <RunConfiguration>
    <!-- 3-minute global timeout for any single test (safety net) -->
    <TestSessionTimeout>300000</TestSessionTimeout>
  </RunConfiguration>
</RunSettings>
