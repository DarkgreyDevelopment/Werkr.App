@page "/workflows/{Id:long}/edit"
@page "/workflows/new"
@rendermode InteractiveServer
@attribute [Authorize( Roles = "Admin,Operator" )]
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>Werkr - @( IsNewMode ? "New" : "Edit" ) Workflow</PageTitle>

<h1>@( IsNewMode ? "New" : "Edit" ) Workflow</h1>
<Breadcrumb Items="_breadcrumbs" />

@if ( !string.IsNullOrWhiteSpace( _errorMessage ) ) {
    <StatusBanner Visible="true" Level="danger" Title="Error" Message="@_errorMessage" />
}

@if ( !string.IsNullOrWhiteSpace( _successMessage ) ) {
    <StatusBanner Visible="true" Level="success" Title="Success" Message="@_successMessage" />
}

@if ( _isLoading ) {
    <LoadingSpinner Message="Loading workflow…" />
} else if ( _model is not null ) {
    @* ── Workflow Metadata ── *@
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Workflow Details</h5>

            <EditForm Model="_model" OnValidSubmit="SaveWorkflowAsync" FormName="EditWorkflow">
                <div class="mb-3">
                    <label class="form-label" for="name">Name</label>
                    <InputText id="name" class="form-control" @bind-Value="_model!.Name" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="desc">Description</label>
                    <InputTextArea id="desc" class="form-control" rows="2" @bind-Value="_model!.Description" />
                </div>

                <div class="mb-3">
                    <ToggleSwitch @bind-Value="_model!.Enabled" Label="Enabled" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Target Tags</label>
                    <TagInput @bind-Value="_model!.TargetTags" />
                </div>

                <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                    @if ( _isSaving ) {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    @( IsNewMode ? "Create Workflow" : "Save Changes" )
                </button>
            </EditForm>
        </div>
    </div>

    @* ── DAG Visualization ── *@
    @if ( DisplaySteps.Count > 0 ) {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Workflow DAG</h5>
                @if ( !IsNewMode ) {
                    <DagCanvas WorkflowId="Id" Steps="_workflow!.Steps" />
                }
            </div>
        </div>
    }

    @* ── DAG Validation ── *@
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">DAG Validation</h5>
            <button class="btn btn-outline-primary" @onclick="ValidateDagAsync" disabled="@( _isValidating || DisplaySteps.Count == 0 )">
                @if ( _isValidating ) {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                Validate DAG
            </button>
            @if ( DisplaySteps.Count == 0 ) {
                <p class="text-muted mt-2">Add steps to validate the DAG.</p>
            }
            @if ( _dagResult is not null ) {
                <div class="mt-2">
                    @if ( _dagResult.IsValid ) {
                        <span class="badge bg-success">Valid</span>
                    } else {
                        <span class="badge bg-danger">Invalid</span>
                        <ul class="mt-2 text-danger">
                            @foreach ( string err in _dagResult.Errors ) {
                                <li>@err</li>
                            }
                        </ul>
                    }
                </div>
            }
        </div>
    </div>

    @* ── Schedules ── *@
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Schedules</h5>
            @if ( DisplaySchedules.Count > 0 ) {
                <div class="table-responsive mb-3">
                    <table class="table table-sm table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach ( ScheduleDto sched in DisplaySchedules ) {
                                <tr>
                                    <td>@sched.Name</td>
                                    <td class="text-end">
                                        <button class="btn btn-outline-primary btn-sm me-1"
                                                @onclick="() => EditScheduleAsync( sched.Id )">
                                            Edit
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm"
                                                @onclick="( ) => DisassociateScheduleAsync( sched.Id )">
                                            Remove
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            } else {
                <p class="text-muted">No schedules associated.</p>
            }

            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Associate Schedule</label>
                    <div class="d-flex gap-1">
                        <select class="form-select" @bind="_selectedScheduleId">
                            <option value="">— select schedule —</option>
                            @if ( _availableSchedules is not null ) {
                                @foreach ( ScheduleDto s in _availableSchedules ) {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            }
                        </select>
                        <button type="button" class="btn btn-outline-success btn-sm text-nowrap"
                                @onclick="OpenCreateScheduleAsync">
                            + New
                        </button>
                    </div>
                </div>
                <div class="col-auto">
                    <button class="btn btn-outline-primary" @onclick="AssociateScheduleAsync"
                            disabled="@string.IsNullOrEmpty( _selectedScheduleId )">
                        Add Schedule
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* ── Steps ── *@
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Steps (@DisplaySteps.Count)</h5>

            @if ( DisplaySteps.Count > 0 ) {
                <div class="table-responsive mb-3">
                    <table class="table table-sm table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>Step ID</th>
                                <th>Task</th>
                                <th>Control</th>
                                <th>Condition</th>
                                <th>Max Iter</th>
                                <th>Dep. Mode</th>
                                <th>Dependencies</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if ( IsNewMode ) {
                                @foreach ( LocalStepModel step in _localSteps.OrderBy( s => s.Order ) ) {
                                    <tr>
                                        <td>@step.Order</td>
                                        <td>@step.LocalId</td>
                                        <td>@TaskName( step.TaskId )</td>
                                        <td><code>@step.ControlStatement</code></td>
                                        <td>@( step.ConditionExpression ?? "—" )</td>
                                        <td>@step.MaxIterations</td>
                                        <td>@step.DependencyMode</td>
                                        <td>
                                            @if ( step.DependsOnLocalIds.Count > 0 ) {
                                                @string.Join( ", ", step.DependsOnLocalIds )
                                            } else {
                                                <span class="text-muted">None</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <button class="btn btn-outline-danger btn-sm"
                                                    @onclick="() => RemoveLocalStep( step.LocalId )">
                                                Remove
                                            </button>
                                        </td>
                                    </tr>
                                }
                            } else {
                                @foreach ( WorkflowStepDto step in _workflow!.Steps.OrderBy( s => s.Order ) ) {
                                    <tr>
                                        <td>@step.Order</td>
                                        <td>@step.Id</td>
                                        <td>@TaskName( step.TaskId )</td>
                                        <td><code>@step.ControlStatement</code></td>
                                        <td>@( step.ConditionExpression ?? "—" )</td>
                                        <td>@step.MaxIterations</td>
                                        <td>@step.DependencyMode</td>
                                        <td>
                                            @if ( step.Dependencies.Count > 0 ) {
                                                @string.Join( ", ", step.Dependencies.Select( d => d.DependsOnStepId ) )
                                            } else {
                                                <span class="text-muted">None</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <button class="btn btn-outline-primary btn-sm me-1"
                                                    @onclick="() => EditTaskAsync( step.TaskId )">
                                                Edit Task
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm"
                                                    @onclick="() => DeleteStepAsync( step.Id )">
                                                Remove
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            } else {
                <p class="text-muted">No steps yet. Add a step below.</p>
            }

            <h6>Add Step</h6>
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Task</label>
                    <div class="d-flex gap-1">
                        <select class="form-select" @bind="_newStep.TaskId">
                            <option value="0">— select task —</option>
                            @if ( _tasks is not null ) {
                                @foreach ( TaskDto t in _tasks ) {
                                    <option value="@t.Id">@t.Name</option>
                                }
                            }
                        </select>
                        <button type="button" class="btn btn-outline-success btn-sm text-nowrap"
                                @onclick="( ) => _taskSetupModal?.Show( )">
                            + New
                        </button>
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Control</label>
                    <select class="form-select" @bind="_newStep.ControlStatement">
                        <option>Default</option>
                        <option>If</option>
                        <option>ElseIf</option>
                        <option>Else</option>
                        <option>While</option>
                        <option>Do</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Dep. Mode</label>
                    <select class="form-select" @bind="_newStep.DependencyMode">
                        <option>All</option>
                        <option>Any</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <button class="btn btn-primary" @onclick="AddStepAsync">Add</button>
                </div>
            </div>
            @if ( IsConditionalControl( _newStep.ControlStatement ) ) {
                <div class="row g-2 mt-2">
                    <div class="col-md-6">
                        <label class="form-label">Condition Expression</label>
                        <ConditionBuilder @bind-Expression="_newStep.ConditionExpression" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Max Iterations</label>
                        <input type="number" class="form-control" @bind="_newStep.MaxIterations" />
                    </div>
                </div>
            }

            @if ( DisplaySteps.Count > 0 ) {
                <h6 class="mt-4">Add Dependency</h6>
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">Step ID</label>
                        <input type="number" class="form-control" @bind="_depStepId" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Depends On Step ID</label>
                        <input type="number" class="form-control" @bind="_depDependsOnStepId" />
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-outline-primary" @onclick="AddDependencyAsync">Add Dependency</button>
                    </div>
                </div>
            }
        </div>
    </div>

    @* ── Recent Runs ── *@
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Recent Runs</h5>
            @if ( !IsNewMode ) {
                <a href="/workflows/@Id/runs" class="btn btn-outline-secondary btn-sm mb-2">View All Runs</a>
            }
            @if ( _runs is not null && _runs.Count > 0 ) {
                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Run ID</th>
                                <th>Started</th>
                                <th>Ended</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach ( WorkflowRunDto run in _runs.Take( 10 ) ) {
                                <tr>
                                    <td><a href="/workflows/runs/@run.Id">@run.Id.ToString()[..8]…</a></td>
                                    <td>@run.StartTime.ToString( "g" )</td>
                                    <td>@( run.EndTime?.ToString( "g" ) ?? "—" )</td>
                                    <td>
                                        <span class="badge @StatusDisplayHelper.GetStatusBadgeClass( run.Status )">@run.Status</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            } else {
                <p class="text-muted">No runs recorded yet.</p>
            }
        </div>
    </div>

    <TaskSetupModal @ref="_taskSetupModal" WorkflowId="Id" OnTaskCreated="OnTaskCreatedAsync" OnTaskUpdated="OnTaskUpdatedAsync" />
    <ScheduleSetupModal @ref="_scheduleSetupModal" OnScheduleCreated="OnScheduleCreatedAsync" OnScheduleUpdated="OnScheduleUpdatedAsync" />
}

@code {
    [Parameter] public long Id { get; set; }

    private bool IsNewMode => Id == 0;

    private WorkflowDto? _workflow;
    private WorkflowFormModel? _model;
    private List<WorkflowRunDto>? _runs;
    private List<TaskDto>? _tasks;
    private List<ScheduleDto>? _schedules;
    private List<ScheduleDto>? _availableSchedules;
    private DagValidationResult? _dagResult;

    // Local state for new mode
    private readonly List<LocalStepModel> _localSteps = [];
    private readonly List<ScheduleDto> _localSchedules = [];
    private long _nextLocalStepId = 1;

    private string? _errorMessage;
    private string? _successMessage;
    private bool _isLoading;
    private bool _isSaving;
    private bool _isValidating;
    private string _selectedScheduleId = "";

    private readonly NewStepModel _newStep = new( );
    private TaskSetupModal? _taskSetupModal;
    private ScheduleSetupModal? _scheduleSetupModal;
    private long _depStepId;
    private long _depDependsOnStepId;

    private List<Breadcrumb.BreadcrumbItem> _breadcrumbs = [
        new( "Workflows", "/workflows" ),
        new( "Edit" )
    ];

    // Unified display helpers
    private IReadOnlyList<LocalStepModel> DisplaySteps =>
        IsNewMode ? _localSteps : _workflow?.Steps.Select( s => LocalStepModel.FromDto( s ) ).ToList( ) ?? [];

    private IReadOnlyList<ScheduleDto> DisplaySchedules =>
        IsNewMode ? _localSchedules : _schedules ?? [];

    protected override async Task OnInitializedAsync( ) {
        if ( IsNewMode ) {
            _model = new WorkflowFormModel( );
            _breadcrumbs = [new( "Workflows", "/workflows" ), new( "New" )];
            await LoadReferenceDataAsync( );
        } else {
            await LoadAsync( );
        }
    }

    private async Task LoadReferenceDataAsync( ) {
        try {
            HttpClient client = HttpClientFactory.CreateClient( "ApiService" );
            _tasks = await client.GetFromJsonAsync<List<TaskDto>>( "/api/tasks" );
            List<ScheduleDto>? allSchedules = await client.GetFromJsonAsync<List<ScheduleDto>>( "/api/schedules" );
            HashSet<Guid> linkedIds = [.. _localSchedules.Select( s => s.Id )];
            _availableSchedules = allSchedules?.Where( s => !linkedIds.Contains( s.Id ) ).ToList( ) ?? [];
        } catch ( Exception ex ) {
            _errorMessage = $"Failed to load reference data: {ex.Message}";
        }
    }

    private async Task LoadAsync( ) {
        _isLoading = true;
        _errorMessage = null;
        try {
            HttpClient client = HttpClientFactory.CreateClient( "ApiService" );
            _workflow = await client.GetFromJsonAsync<WorkflowDto>( $"/api/workflows/{Id}" );
            if ( _workflow is null ) {
                _errorMessage = "Workflow not found.";
                return;
            }
            _breadcrumbs = [new( "Workflows", "/workflows" ), new( _workflow.Name, $"/workflows/{Id}" ), new( "Edit" )];
            _model = new WorkflowFormModel {
                Name = _workflow.Name,
                Description = _workflow.Description,
                Enabled = _workflow.Enabled,
                TargetTags = _workflow.TargetTags ?? [],
            };
            _runs = await client.GetFromJsonAsync<List<WorkflowRunDto>>( $"/api/workflows/{Id}/runs" );
            _tasks = await client.GetFromJsonAsync<List<TaskDto>>( "/api/tasks" );
            _schedules = await client.GetFromJsonAsync<List<ScheduleDto>>( $"/api/workflows/{Id}/schedules" );
            List<ScheduleDto>? allSchedules = await client.GetFromJsonAsync<List<ScheduleDto>>( "/api/schedules" );
            HashSet<Guid> linkedIds = _schedules is not null
                ? [.. _schedules.Select( s => s.Id )]
                : [];
            _availableSchedules = allSchedules?.Where( s => !linkedIds.Contains( s.Id ) ).ToList( ) ?? [];
        } catch ( Exception ex ) {
            _errorMessage = $"Failed to load workflow: {ex.Message}";
        } finally {
            _isLoading = false;
        }
    }

    private async Task SaveWorkflowAsync( ) {
        if ( _model is null ) return;
        _isSaving = true;
        _errorMessage = null;
        _successMessage = null;
        try {
            HttpClient client = HttpClientFactory.CreateClient( "ApiService" );

            if ( IsNewMode ) {
                WorkflowCreateRequest createRequest = new(
                    Name: _model.Name,
                    Description: _model.Description,
                    Enabled: _model.Enabled,
                    TargetTags: _model.TargetTags.Length > 0 ? _model.TargetTags : null );

                HttpResponseMessage response = await client.PostAsJsonAsync( "/api/workflows", createRequest );
                if ( !response.IsSuccessStatusCode ) {
                    string body = await response.Content.ReadAsStringAsync( );
                    _errorMessage = $"Failed to create workflow: {body}";
                    return;
                }

                WorkflowDto? created = await response.Content.ReadFromJsonAsync<WorkflowDto>( );
                long workflowId = created?.Id ?? 0;
                if ( workflowId == 0 ) {
                    _errorMessage = "Failed to create workflow: no ID returned.";
                    return;
                }

                // Add steps and collect real IDs
                Dictionary<long, long> localToRealStepId = [];
                foreach ( LocalStepModel step in _localSteps.OrderBy( s => s.Order ) ) {
                    WorkflowStepCreateRequest stepReq = new(
                        TaskId: step.TaskId,
                        Order: step.Order,
                        ControlStatement: step.ControlStatement,
                        ConditionExpression: string.IsNullOrWhiteSpace( step.ConditionExpression ) ? null : step.ConditionExpression,
                        MaxIterations: step.MaxIterations,
                        DependencyMode: step.DependencyMode );

                    HttpResponseMessage stepResp = await client.PostAsJsonAsync(
                        $"/api/workflows/{workflowId}/steps", stepReq );
                    if ( !stepResp.IsSuccessStatusCode ) {
                        string body = await stepResp.Content.ReadAsStringAsync( );
                        _errorMessage = $"Workflow created but failed to add step (order {step.Order}): {body}";
                        Id = workflowId;
                        await LoadAsync( );
                        return;
                    }

                    WorkflowStepDto? createdStep = await stepResp.Content.ReadFromJsonAsync<WorkflowStepDto>( );
                    if ( createdStep is not null ) {
                        localToRealStepId[step.LocalId] = createdStep.Id;
                    }
                }

                // Add dependencies using mapped real IDs
                foreach ( LocalStepModel step in _localSteps ) {
                    if ( step.DependsOnLocalIds.Count == 0 ) continue;
                    if ( !localToRealStepId.TryGetValue( step.LocalId, out long realStepId ) ) continue;

                    foreach ( long depLocalId in step.DependsOnLocalIds ) {
                        if ( !localToRealStepId.TryGetValue( depLocalId, out long realDepId ) ) continue;
                        StepDependencyRequest depReq = new( realDepId );
                        HttpResponseMessage depResp = await client.PostAsJsonAsync(
                            $"/api/workflows/{workflowId}/steps/{realStepId}/dependencies", depReq );
                        if ( !depResp.IsSuccessStatusCode ) {
                            string body = await depResp.Content.ReadAsStringAsync( );
                            _errorMessage = $"Workflow created but failed to add dependency: {body}";
                            Id = workflowId;
                            await LoadAsync( );
                            return;
                        }
                    }
                }

                // Associate schedules
                foreach ( ScheduleDto sched in _localSchedules ) {
                    HttpResponseMessage schedResp = await client.PostAsJsonAsync(
                        $"/api/workflows/{workflowId}/schedules", new WorkflowScheduleAssociateRequest( sched.Id ) );
                    if ( !schedResp.IsSuccessStatusCode ) {
                        string body = await schedResp.Content.ReadAsStringAsync( );
                        _errorMessage = $"Workflow created but failed to associate schedule '{sched.Name}': {body}";
                        Id = workflowId;
                        await LoadAsync( );
                        return;
                    }
                }

                Id = workflowId;
                _localSteps.Clear( );
                _localSchedules.Clear( );
                _successMessage = "Workflow created successfully.";
                await LoadAsync( );
            } else {
                WorkflowUpdateRequest request = new(
                    Name: _model.Name,
                    Description: _model.Description,
                    Enabled: _model.Enabled,
                    TargetTags: _model.TargetTags.Length > 0 ? _model.TargetTags : null );

                HttpResponseMessage response = await client.PutAsJsonAsync( $"/api/workflows/{Id}", request );
                if ( response.IsSuccessStatusCode ) {
                    _successMessage = "Workflow saved.";
                    await LoadAsync( );
                } else {
                    string body = await response.Content.ReadAsStringAsync( );
                    _errorMessage = $"Failed to save: {body}";
                }
            }
        } catch ( Exception ex ) {
            _errorMessage = $"Failed to save: {ex.Message}";
        } finally {
            _isSaving = false;
        }
    }

    private async Task ValidateDagAsync( ) {
        _isValidating = true;
        _errorMessage = null;
        try {
            if ( IsNewMode ) {
                _dagResult = ValidateDagLocally( );
            } else {
                HttpClient client = HttpClientFactory.CreateClient( "ApiService" );
                HttpResponseMessage response = await client.PostAsync( $"/api/workflows/{Id}/validate", null );
                _dagResult = await response.Content.ReadFromJsonAsync<DagValidationResult>( );
            }
        } catch ( Exception ex ) {
            _errorMessage = $"Validation failed: {ex.Message}";
        } finally {
            _isValidating = false;
        }
    }

    private DagValidationResult ValidateDagLocally( ) {
        List<string> errors = [];

        if ( _localSteps.Count == 0 ) {
            return new DagValidationResult( false, ["No steps defined."] );
        }

        // Validate control flow
        foreach ( LocalStepModel step in _localSteps ) {
            if ( step.ControlStatement is "If" or "ElseIf" or "While" ) {
                if ( string.IsNullOrWhiteSpace( step.ConditionExpression ) ) {
                    errors.Add( $"Step {step.LocalId} ({step.ControlStatement}) requires a condition expression." );
                }
            }
            if ( step.ControlStatement is "While" or "Do" ) {
                if ( step.MaxIterations <= 0 ) {
                    errors.Add( $"Step {step.LocalId} ({step.ControlStatement}) requires MaxIterations > 0." );
                }
            }
            if ( step.ControlStatement is "Else" or "ElseIf" ) {
                bool dependsOnConditional = step.DependsOnLocalIds.Any( depId =>
                    _localSteps.Any( s => s.LocalId == depId && s.ControlStatement is "If" or "ElseIf" ) );
                if ( !dependsOnConditional ) {
                    errors.Add( $"Step {step.LocalId} ({step.ControlStatement}) must depend on an If or ElseIf step." );
                }
            }
        }

        // Cycle detection via Kahn's algorithm
        HashSet<long> allIds = [.. _localSteps.Select( s => s.LocalId )];
        Dictionary<long, int> inDegree = allIds.ToDictionary( id => id, _ => 0 );
        Dictionary<long, List<long>> adjacency = allIds.ToDictionary( id => id, _ => new List<long>( ) );

        foreach ( LocalStepModel step in _localSteps ) {
            foreach ( long depId in step.DependsOnLocalIds ) {
                if ( !allIds.Contains( depId ) ) {
                    errors.Add( $"Step {step.LocalId} depends on non-existent step {depId}." );
                    continue;
                }
                adjacency[depId].Add( step.LocalId );
                inDegree[step.LocalId]++;
            }
        }

        Queue<long> queue = new( inDegree.Where( kv => kv.Value == 0 ).Select( kv => kv.Key ) );
        int sorted = 0;
        while ( queue.Count > 0 ) {
            long current = queue.Dequeue( );
            sorted++;
            foreach ( long neighbor in adjacency[current] ) {
                inDegree[neighbor]--;
                if ( inDegree[neighbor] == 0 ) queue.Enqueue( neighbor );
            }
        }

        if ( sorted != allIds.Count ) {
            errors.Add( "Cycle detected in the workflow DAG." );
        }

        return new DagValidationResult( errors.Count == 0, errors );
    }

    private async Task AddStepAsync( ) {
        _errorMessage = null;

        if ( IsNewMode ) {
            int autoOrder = _localSteps.Count > 0
                ? _localSteps.Max( s => s.Order ) + 1
                : 1;

            _localSteps.Add( new LocalStepModel {
                LocalId = _nextLocalStepId++,
                TaskId = _newStep.TaskId,
                Order = autoOrder,
                ControlStatement = _newStep.ControlStatement,
                ConditionExpression = string.IsNullOrWhiteSpace( _newStep.ConditionExpression ) ? null : _newStep.ConditionExpression,
                MaxIterations = _newStep.MaxIterations,
                DependencyMode = _newStep.DependencyMode,
            } );

            _newStep.TaskId = 0;
            _newStep.ControlStatement = "Default";
            _newStep.ConditionExpression = null;
            _newStep.MaxIterations = 100;
            _newStep.DependencyMode = "All";
            return;
        }

        try {
            int autoOrder = _workflow?.Steps.Count > 0
                ? _workflow.Steps.Max( s => s.Order ) + 1
                : 1;

            WorkflowStepCreateRequest request = new(
                TaskId: _newStep.TaskId,
                Order: autoOrder,
                ControlStatement: _newStep.ControlStatement,
                ConditionExpression: string.IsNullOrWhiteSpace( _newStep.ConditionExpression ) ? null : _newStep.ConditionExpression,
                MaxIterations: _newStep.MaxIterations,
                DependencyMode: _newStep.DependencyMode );

            HttpClient client = HttpClientFactory.CreateClient( "ApiService" );
            HttpResponseMessage response = await client.PostAsJsonAsync(
                $"/api/workflows/{Id}/steps", request );
            if ( response.IsSuccessStatusCode ) {
                await LoadAsync( );
            } else {
                string body = await response.Content.ReadAsStringAsync( );
                _errorMessage = $"Failed to add step: {body}";
            }
        } catch ( Exception ex ) {
            _errorMessage = $"Failed to add step: {ex.Message}";
        }
    }

    private async Task DeleteStepAsync( long stepId ) {
        _errorMessage = null;
        try {
            HttpClient client = HttpClientFactory.CreateClient( "ApiService" );
            HttpResponseMessage response = await client.DeleteAsync(
                $"/api/workflows/{Id}/steps/{stepId}" );
            if ( response.IsSuccessStatusCode ) {
                await LoadAsync( );
            } else {
                _errorMessage = $"Failed to remove step: HTTP {(int) response.StatusCode}";
            }
        } catch ( Exception ex ) {
            _errorMessage = $"Failed to remove step: {ex.Message}";
        }
    }

    private async Task AddDependencyAsync( ) {
        _errorMessage = null;

        if ( IsNewMode ) {
            LocalStepModel? step = _localSteps.FirstOrDefault( s => s.LocalId == _depStepId );
            if ( step is null ) {
                _errorMessage = $"Step {_depStepId} not found.";
                return;
            }
            if ( !_localSteps.Any( s => s.LocalId == _depDependsOnStepId ) ) {
                _errorMessage = $"Depends-on step {_depDependsOnStepId} not found.";
                return;
            }
            if ( !step.DependsOnLocalIds.Contains( _depDependsOnStepId ) ) {
                step.DependsOnLocalIds.Add( _depDependsOnStepId );
            }
            return;
        }

        try {
            StepDependencyRequest request = new( _depDependsOnStepId );
            HttpClient client = HttpClientFactory.CreateClient( "ApiService" );
            HttpResponseMessage response = await client.PostAsJsonAsync(
                $"/api/workflows/{Id}/steps/{_depStepId}/dependencies", request );
            if ( response.IsSuccessStatusCode ) {
                await LoadAsync( );
            } else {
                string body = await response.Content.ReadAsStringAsync( );
                _errorMessage = $"Failed to add dependency: {body}";
            }
        } catch ( Exception ex ) {
            _errorMessage = $"Failed to add dependency: {ex.Message}";
        }
    }

    private string TaskName( long taskId ) {
        TaskDto? t = _tasks?.FirstOrDefault( x => x.Id == taskId );
        return t is not null ? t.Name : $"Task #{taskId}";
    }

    private static bool IsConditionalControl( string control ) =>
        control is "If" or "ElseIf" or "While" or "Do";

    private async Task AssociateScheduleAsync( ) {
        if ( string.IsNullOrEmpty( _selectedScheduleId ) || !Guid.TryParse( _selectedScheduleId, out Guid schedId ) ) return;
        _errorMessage = null;

        if ( IsNewMode ) {
            ScheduleDto? sched = _availableSchedules?.FirstOrDefault( s => s.Id == schedId );
            if ( sched is not null ) {
                _localSchedules.Add( sched );
                _availableSchedules?.Remove( sched );
                _selectedScheduleId = "";
            }
            return;
        }

        try {
            HttpClient client = HttpClientFactory.CreateClient( "ApiService" );
            HttpResponseMessage response = await client.PostAsJsonAsync(
                $"/api/workflows/{Id}/schedules", new WorkflowScheduleAssociateRequest( schedId ) );
            if ( response.IsSuccessStatusCode ) {
                _selectedScheduleId = "";
                await LoadAsync( );
            } else {
                string body = await response.Content.ReadAsStringAsync( );
                _errorMessage = $"Failed to associate schedule: {body}";
            }
        } catch ( Exception ex ) {
            _errorMessage = $"Failed to associate schedule: {ex.Message}";
        }
    }

    private async Task DisassociateScheduleAsync( Guid scheduleId ) {
        _errorMessage = null;

        if ( IsNewMode ) {
            ScheduleDto? sched = _localSchedules.FirstOrDefault( s => s.Id == scheduleId );
            if ( sched is not null ) {
                _localSchedules.Remove( sched );
                _availableSchedules?.Add( sched );
            }
            return;
        }

        try {
            HttpClient client = HttpClientFactory.CreateClient( "ApiService" );
            HttpResponseMessage response = await client.DeleteAsync(
                $"/api/workflows/{Id}/schedules/{scheduleId}" );
            if ( response.IsSuccessStatusCode ) {
                await LoadAsync( );
            } else {
                _errorMessage = $"Failed to remove schedule: HTTP {(int) response.StatusCode}";
            }
        } catch ( Exception ex ) {
            _errorMessage = $"Failed to remove schedule: {ex.Message}";
        }
    }

    private async Task OnTaskCreatedAsync( TaskDto task ) {
        _newStep.TaskId = task.Id;
        if ( IsNewMode ) {
            await LoadReferenceDataAsync( );
        } else {
            await LoadAsync( );
        }
    }

    private async Task OnTaskUpdatedAsync( TaskDto task ) {
        if ( IsNewMode ) {
            await LoadReferenceDataAsync( );
        } else {
            await LoadAsync( );
        }
    }

    private void EditTaskAsync( long taskId ) {
        TaskDto? task = _tasks?.FirstOrDefault( x => x.Id == taskId );
        if ( task is not null ) {
            _taskSetupModal?.Show( task );
        }
    }

    private async Task OpenCreateScheduleAsync( ) {
        if ( _scheduleSetupModal is not null ) await _scheduleSetupModal.Show( );
    }

    private async Task EditScheduleAsync( Guid scheduleId ) {
        ScheduleDto? sched = DisplaySchedules.FirstOrDefault( s => s.Id == scheduleId )
            ?? _availableSchedules?.FirstOrDefault( s => s.Id == scheduleId );
        if ( sched is not null && _scheduleSetupModal is not null ) {
            await _scheduleSetupModal.Show( sched );
        }
    }

    private async Task OnScheduleCreatedAsync( ScheduleDto schedule ) {
        _errorMessage = null;
        if ( IsNewMode ) {
            _localSchedules.Add( schedule );
            _availableSchedules?.RemoveAll( s => s.Id == schedule.Id );
        } else {
            try {
                HttpClient client = HttpClientFactory.CreateClient( "ApiService" );
                HttpResponseMessage response = await client.PostAsJsonAsync(
                    $"/api/workflows/{Id}/schedules", new WorkflowScheduleAssociateRequest( schedule.Id ) );
                if ( !response.IsSuccessStatusCode ) {
                    string body = await response.Content.ReadAsStringAsync( );
                    _errorMessage = $"Schedule created but failed to associate: {body}";
                }
                await LoadAsync( );
            } catch ( Exception ex ) {
                _errorMessage = $"Schedule created but failed to associate: {ex.Message}";
            }
        }
    }

    private async Task OnScheduleUpdatedAsync( ScheduleDto schedule ) {
        if ( IsNewMode ) {
            int idx = _localSchedules.FindIndex( s => s.Id == schedule.Id );
            if ( idx >= 0 ) _localSchedules[idx] = schedule;
            await LoadReferenceDataAsync( );
        } else {
            await LoadAsync( );
        }
    }

    private sealed class WorkflowFormModel {
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public bool Enabled { get; set; } = true;
        public string[] TargetTags { get; set; } = [];
    }

    private sealed class NewStepModel {
        public long TaskId { get; set; }
        public string ControlStatement { get; set; } = "Default";
        public string DependencyMode { get; set; } = "All";
        public string? ConditionExpression { get; set; }
        public int MaxIterations { get; set; } = 100;
    }

    private void RemoveLocalStep( long localId ) {
        _localSteps.RemoveAll( s => s.LocalId == localId );
        foreach ( LocalStepModel step in _localSteps ) {
            step.DependsOnLocalIds.Remove( localId );
        }
    }

    private sealed class LocalStepModel {
        public long LocalId { get; set; }
        public long TaskId { get; set; }
        public int Order { get; set; }
        public string ControlStatement { get; set; } = "Default";
        public string? ConditionExpression { get; set; }
        public int MaxIterations { get; set; } = 100;
        public string DependencyMode { get; set; } = "All";
        public List<long> DependsOnLocalIds { get; set; } = [];

        public static LocalStepModel FromDto( WorkflowStepDto dto ) => new( ) {
            LocalId = dto.Id,
            TaskId = dto.TaskId,
            Order = dto.Order,
            ControlStatement = dto.ControlStatement,
            ConditionExpression = dto.ConditionExpression,
            MaxIterations = dto.MaxIterations,
            DependencyMode = dto.DependencyMode,
            DependsOnLocalIds = [.. dto.Dependencies.Select( d => d.DependsOnStepId )],
        };
    }
}
