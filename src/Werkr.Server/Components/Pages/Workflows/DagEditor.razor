@page "/workflows/{Id:long}/dag-editor"
@page "/workflows/{Id:long}/edit"
@page "/workflows/new/dag-editor"
@page "/workflows/new/edit"
@rendermode InteractiveServer
@attribute [Authorize( Roles = "Admin,Operator" )]
@inject Werkr.Server.Services.ApiServiceAccessor Api
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState
@inject ILogger<DagEditor> Logger

<PageTitle>Werkr - @( IsNewMode ? "New" : "Edit" ) Workflow</PageTitle>

<h1>@( IsNewMode ? "New" : "Edit" ) Workflow</h1>
<Breadcrumb Items="_breadcrumbs" />

@if ( !string.IsNullOrWhiteSpace( _errorMessage ) ) {
    <StatusBanner Visible="true" Level="danger" Title="Error" Message="@_errorMessage" />
}

@if ( !string.IsNullOrWhiteSpace( _successMessage ) ) {
    <StatusBanner Visible="true" Level="success" Title="Success" Message="@_successMessage" />
}

@if ( _isLoading ) {
    <LoadingSpinner Message="Loading workflow…" />
} else if ( _model is not null ) {
    @* ── Draft Restore Prompt ── *@
    @if ( _hasDraft && !_draftDismissed ) {
        <div class="alert alert-info d-flex align-items-center justify-content-between">
            <span><i class="bi bi-clock-history me-2"></i>An unsaved draft was found.</span>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-primary" @onclick="RestoreDraftAsync">Restore</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="DismissDraftAsync">Dismiss</button>
            </div>
        </div>
    }

    @* ── Toolbar ── *@
    <EditorToolbar DirtyCount="_dirtyCount"
                   IsSaving="_isSaving"
                   IsValidating="_isValidating"
                   Direction="_direction"
                   ZoomLevel="_zoomLevel"
                   GridVisible="_gridVisible"
                   OnSave="SaveAsync"
                   OnUndo="UndoAsync"
                   OnRedo="RedoAsync"
                   OnValidate="ValidateDagAsync"
                   OnAutoLayout="AutoLayoutAsync"
                   OnZoomIn="ZoomInAsync"
                   OnZoomOut="ZoomOutAsync"
                   OnZoomFit="ZoomFitAsync"
                   OnDirectionChanged="SetDirectionAsync"
                   OnExportSvg="ExportSvgAsync"
                   OnExportPng="ExportPngAsync"
                   OnToggleGrid="ToggleGridAsync"
                   OnAddAnnotation="AddAnnotationAsync" />

    @* ── Workflow Metadata (collapsible) ── *@
    <details class="card mb-3">
        <summary class="card-header d-flex align-items-center">
            <i class="bi bi-chevron-right me-2 details-chevron"></i>
            <h5 class="mb-0 d-inline">Workflow Details</h5>
        </summary>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="wf-name">Name</label>
                    <InputText id="wf-name" class="form-control" @bind-Value="_model!.Name" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="wf-desc">Description</label>
                    <InputTextArea id="wf-desc" class="form-control" rows="2" @bind-Value="_model!.Description" />
                </div>
                <div class="col-md-3">
                    <ToggleSwitch @bind-Value="_model!.Enabled" Label="Enabled" />
                </div>
                <div class="col-md-9">
                    <label class="form-label">Target Tags</label>
                    <TagInput @bind-Value="_model!.TargetTags" />
                </div>
            </div>
        </div>
    </details>

    @* ── DAG Validation ── *@
    @if ( _dagResult is not null ) {
        <div class="mb-3">
            @if ( _dagResult.IsValid ) {
                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>DAG Valid</span>
            } else {
                <div class="alert alert-danger py-2">
                    <strong>DAG Invalid:</strong>
                    <ul class="mb-0 mt-1">
                        @foreach ( string err in _dagResult.Errors ) {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }
        </div>
    }

    @* ── Editor Layout: Palette | Canvas | Config Panel ── *@
    <div class="dag-editor-layout d-flex" style="height: calc(100vh - 320px); min-height: 400px;">
        @* ── Step Palette (left) ── *@
        <StepPalette OnPaletteDragStart="HandlePaletteDragStartAsync"
                     OnCompositeDragStart="HandleCompositeDragStartAsync" />

        @* ── Canvas (center) ── *@
        <DagEditorCanvas @ref="_canvas"
                         WorkflowId="@_workflowId"
                         UserId="@_userId"
                         OnNodeSelected="HandleNodeSelectedAsync"
                         OnNodeDeselected="HandleNodeDeselectedAsync"
                         OnNodeDropped="HandleNodeDroppedAsync"
                         OnSaveRequested="SaveAsync"
                         OnCycleDetected="HandleCycleDetectedAsync"
                         OnDirtyCountChanged="HandleDirtyCountChangedAsync"
                         OnZoomChanged="HandleZoomChanged"
                         OnCanvasReady="HandleCanvasReadyAsync" />

        @* ── Config Panel (right) ── *@
        <NodeConfigPanel SelectedStepId="_selectedStepId"
                         Tasks="_tasks"
                         Dependencies="_selectedStepDependencies"
                         TaskId="_selectedTaskId"
                         TaskName="@_selectedTaskName"
                         ActionKey="@_selectedActionKey"
                         ControlStatement="@_selectedControlStatement"
                         ConditionExpression="@_selectedConditionExpression"
                         MaxIterations="_selectedMaxIterations"
                         DependencyMode="@_selectedDependencyMode"
                         InputVariableName="@_selectedInputVariable"
                         OutputVariableName="@_selectedOutputVariable"
                         IsComposite="_selectedIsComposite"
                         CompositeType="@_selectedCompositeType"
                         ChildWorkflowId="_selectedChildWorkflowId"
                         CollectionVariableName="@_selectedCollectionVariable"
                         IterationVariableName="@_selectedIterationVariable"
                         OnFieldChanged="HandleFieldChangedAsync"
                         OnClose="HandleConfigPanelClose"
                         OnDelete="HandleDeleteSelectedAsync"
                         OnEditTaskRequested="HandleEditTaskAsync"
                         OnCreateTaskRequested="HandleCreateTaskAsync"
                         OnRemoveDependency="HandleRemoveDependencyAsync" />
    </div>

    @* ── Status Bar ── *@
    <div class="d-flex align-items-center gap-3 mt-2 small text-muted">
        <span>Steps: @_stepCount</span>
        <span>Edges: @_edgeCount</span>
        @if ( _lastSaved.HasValue ) {
            <span>Last saved: @_lastSaved.Value.ToString( "HH:mm:ss" )</span>
        }
        <span class="ms-auto badge @( _selectedStepId.HasValue ? "bg-success" : "bg-secondary" )">
            DEBUG selectedStepId=@( _selectedStepId?.ToString() ?? "null" )
        </span>
    </div>

    <TaskSetupModal @ref="_taskSetupModal" WorkflowId="_workflowId" OnTaskCreated="OnTaskCreatedAsync" OnTaskUpdated="OnTaskUpdatedAsync" />
}

@code {
    [Parameter] public long Id { get; set; }

    /// <summary>Effective workflow ID. Starts as the route parameter, updated to the real ID after first save.</summary>
    private long _workflowId;

    private bool IsNewMode => _workflowId == 0;

    // ── State ──
    private WorkflowDto? _workflow;
    private WorkflowFormModel? _model;
    private List<TaskDto>? _tasks;
    private DagValidationResult? _dagResult;
    private DagEditorCanvas? _canvas;
    private TaskSetupModal? _taskSetupModal;

    private string _userId = "";
    private string? _errorMessage;
    private string? _successMessage;
    private bool _isLoading;
    private bool _isSaving;
    private bool _isValidating;
    private bool _hasDraft;
    private bool _draftDismissed;
    private string _direction = "LR";
    private double _zoomLevel = 1.0;
    private int _dirtyCount;
    private int _stepCount;
    private int _edgeCount;
    private long _nextTempStepId = -1;
    private int _annotationCount;
    private DateTime? _lastSaved;
    private bool _gridVisible;

    // ── Selected Node State ──
    private long? _selectedStepId;
    private long _selectedTaskId;
    private string _selectedTaskName = "";
    private string _selectedControlStatement = "Default";
    private string? _selectedConditionExpression;
    private int _selectedMaxIterations = 100;
    private string _selectedDependencyMode = "AllSuccess";
    private string? _selectedInputVariable;
    private string? _selectedOutputVariable;
    private IReadOnlyList<long>? _selectedStepDependencies;
    private bool _selectedIsComposite;
    private string _selectedCompositeType = "None";
    private long? _selectedChildWorkflowId;
    private string? _selectedCollectionVariable;
    private string? _selectedIterationVariable;

    private List<Breadcrumb.BreadcrumbItem> _breadcrumbs = [];

    // Track all state for unsaved temp nodes (stepId → state)
    private readonly Dictionary<long, TempNodeState> _tempNodes = new( );
    private string? _selectedActionKey;

    private static readonly System.Text.Json.JsonSerializerOptions s_jsonWeb = new( System.Text.Json.JsonSerializerDefaults.Web );

    protected override async Task OnInitializedAsync( ) {
        _workflowId = Id;
        AuthenticationState authState = await AuthState.GetAuthenticationStateAsync( );
        _userId = authState.User.Identity?.Name ?? "unknown";

        if ( IsNewMode ) {
            _breadcrumbs = [new( "Workflows", "/workflows" ), new( "New Editor" )];
            _model = new WorkflowFormModel( );
            await LoadReferenceDataAsync( );
        } else {
            await LoadAsync( );
        }
    }

    private async Task HandleCanvasReadyAsync( ) {
        if ( _canvas?.Interop is null ) return;

        // Canvas just initialized — load graph data if available
        if ( _workflow is not null && !IsNewMode ) {
            await LoadGraphIntoCanvasAsync( );
            _hasDraft = await _canvas.Interop.CheckDraftAsync( _userId, _workflowId );
            if ( _hasDraft ) {
                await InvokeAsync( StateHasChanged );
            }
        }
    }

    private async Task LoadReferenceDataAsync( ) {
        try {
            _tasks = await Api.GetAsync<List<TaskDto>>( "/api/v1/tasks" );
        } catch ( Exception ex ) {
            _errorMessage = $"Failed to load tasks: {ex.Message}";
        }
    }

    private async Task LoadAsync( ) {
        _isLoading = true;
        _errorMessage = null;
        try {
            _workflow = await Api.GetAsync<WorkflowDto>( $"/api/v1/workflows/{_workflowId}" );
            if ( _workflow is null ) {
                _errorMessage = "Workflow not found.";
                return;
            }

            if ( _workflow.IsChildWorkflow && _workflow.ParentStepId.HasValue ) {
                _breadcrumbs = [
                    new( "Workflows", "/workflows" ),
                    new( "Parent Workflow", $"/workflows/{_workflow.ParentStepId.Value}/dag-editor" ),
                    new( "ForEach Step" ),
                    new( $"{_workflow.Name} (Inner Workflow)" )
                ];
            } else {
                _breadcrumbs = [
                    new( "Workflows", "/workflows" ),
                    new( _workflow.Name, $"/workflows/{_workflowId}" ),
                    new( "Editor" )
                ];
            }

            _model = new WorkflowFormModel {
                Name = _workflow.Name,
                Description = _workflow.Description,
                Enabled = _workflow.Enabled,
                TargetTags = _workflow.TargetTags ?? [],
            };

            _tasks = await Api.GetAsync<List<TaskDto>>( "/api/v1/tasks" );
            _stepCount = _workflow.Steps.Count;
            _edgeCount = _workflow.Steps.Sum( s => s.Dependencies.Count );
        } catch ( Exception ex ) {
            _errorMessage = $"Failed to load workflow: {ex.Message}";
        } finally {
            _isLoading = false;
        }
    }

    /// <summary>
    /// Reload workflow + task data after save and rebuild the canvas graph
    /// so node IDs match the server (temp IDs → real IDs).
    /// </summary>
    private async Task ReloadAfterSaveAsync( ) {
        try {
            _workflow = await Api.GetAsync<WorkflowDto>( $"/api/v1/workflows/{_workflowId}" );
            _tasks = await Api.GetAsync<List<TaskDto>>( "/api/v1/tasks" );

            if ( _workflow is not null ) {
                _stepCount = _workflow.Steps.Count;
                _edgeCount = _workflow.Steps.Sum( s => s.Dependencies.Count );

                _breadcrumbs = [
                    new( "Workflows", "/workflows" ),
                    new( _workflow.Name, $"/workflows/{_workflowId}" ),
                    new( "Editor" )
                ];

                // Rebuild the canvas with real IDs from the server
                if ( _canvas?.Interop is not null ) {
                    await LoadGraphIntoCanvasAsync( );
                }
            }

            _tempNodes.Clear( );
            _selectedStepId = null;
            _selectedActionKey = null;
        } catch ( Exception ex ) {
            _errorMessage = $"Failed to reload after save: {ex.Message}";
        }
    }

    private async Task LoadGraphIntoCanvasAsync( ) {
        if ( _canvas?.Interop is null || _workflow is null ) return;

        object[] nodes = _workflow.Steps.Select( step => (object) new {
            stepId = step.Id,
            stepLabel = step.IsComposite ? $"ForEach #{step.Order}" : $"Step #{step.Order}",
            taskName = step.IsComposite ? "ForEach" : ( step.TaskName ?? $"Task {step.TaskId ?? 0}" ),
            controlStatement = step.ControlStatement,
            order = step.Order,
            taskId = step.TaskId ?? 0,
            inputVariableName = step.InputVariableName,
            outputVariableName = step.OutputVariableName,
            dependencyMode = step.DependencyMode,
            conditionExpression = step.ConditionExpression,
            maxIterations = step.MaxIterations,
            isComposite = step.IsComposite,
            compositeType = step.CompositeType,
            childWorkflowId = step.ChildWorkflowId,
        } ).ToArray( );

        object[] edges = _workflow.Steps
            .SelectMany( step => step.Dependencies.Select( dep => (object) new {
                sourceStepId = dep.DependsOnStepId,
                targetStepId = step.Id,
            } ) )
            .ToArray( );

        await _canvas.Interop.LoadGraphAsync( nodes, edges );

        // Load annotations if present
        if ( _workflow.Annotations is { Count: > 0 } ) {
            string annotationsJson = System.Text.Json.JsonSerializer.Serialize( _workflow.Annotations, s_jsonWeb );
            await _canvas.Interop.LoadAnnotationsAsync( annotationsJson );
        }
    }

    // ── Toolbar Actions ──

    private async Task SaveAsync( ) {
        if ( _canvas?.Interop is null || _isSaving ) return;
        _isSaving = true;
        _errorMessage = null;
        _successMessage = null;

        try {
            if ( _model is null || string.IsNullOrWhiteSpace( _model.Name ) ) {
                _errorMessage = "Please enter a workflow name before saving.";
                return;
            }

            // ── Create or update workflow metadata ──
            if ( IsNewMode ) {
                WorkflowCreateRequest createRequest = new(
                    Name: _model.Name,
                    Description: _model.Description,
                    Enabled: _model.Enabled,
                    TargetTags: _model.TargetTags.Length > 0 ? _model.TargetTags : null );

                HttpResponseMessage createResponse = await Api.PostAsJsonAsync( "/api/v1/workflows", createRequest );
                if ( !createResponse.IsSuccessStatusCode ) {
                    string body = await createResponse.Content.ReadAsStringAsync( );
                    _errorMessage = $"Failed to create workflow: {body}";
                    return;
                }

                WorkflowDto? created = await createResponse.Content.ReadFromJsonAsync<WorkflowDto>( );
                if ( created is null || created.Id == 0 ) {
                    _errorMessage = "Failed to create workflow: no ID returned.";
                    return;
                }

                _workflowId = created.Id;
            } else {
                // Update metadata on existing workflow
                List<AnnotationDto>? annotations = null;
                if ( _canvas?.Interop is not null ) {
                    string annotationsJson = await _canvas.Interop.GetAnnotationsJsonAsync( );
                    if ( !string.IsNullOrEmpty( annotationsJson ) && annotationsJson != "[]" ) {
                        annotations = System.Text.Json.JsonSerializer.Deserialize<List<AnnotationDto>>( annotationsJson, s_jsonWeb );
                    }
                }

                WorkflowUpdateRequest updateRequest = new(
                    Name: _model.Name,
                    Description: _model.Description,
                    Enabled: _model.Enabled,
                    TargetTags: _model.TargetTags.Length > 0 ? _model.TargetTags : null,
                    Annotations: annotations );

                HttpResponseMessage updateResponse = await Api.PutAsJsonAsync( $"/api/v1/workflows/{_workflowId}", updateRequest );
                if ( !updateResponse.IsSuccessStatusCode ) {
                    string body = await updateResponse.Content.ReadAsStringAsync( );
                    _errorMessage = $"Failed to save workflow metadata: {body}";
                    return;
                }
            }

            // ── Save steps (batch changeset) ──
            string changesetJson = _canvas?.Interop is not null
                ? await _canvas.Interop.GetChangesetJsonAsync( )
                : "{}";
            bool hasStepChanges = !string.IsNullOrEmpty( changesetJson )
                && changesetJson != "{}"
                && changesetJson != "{\"operations\":[]}";

            if ( hasStepChanges ) {
                HttpResponseMessage response = await Api.PostAsync(
                    $"/api/v1/workflows/{_workflowId}/steps/batch",
                    new StringContent( changesetJson, System.Text.Encoding.UTF8, "application/json" ) );

                string responseBody = await response.Content.ReadAsStringAsync( );
                if ( !response.IsSuccessStatusCode ) {
                    _errorMessage = $"Save failed: {responseBody}";
                    return;
                }
            }

            if ( _canvas?.Interop is not null ) {
                await _canvas.Interop.ClearChangesetAsync( );
            }
            _lastSaved = DateTime.Now;
            _successMessage = "Changes saved.";
            await ReloadAfterSaveAsync( );
        } catch ( Exception ex ) {
            _errorMessage = $"Save failed: {ex.Message}";
        } finally {
            _isSaving = false;
        }
    }

    private async Task UndoAsync( ) {
        if ( _canvas?.Interop is not null ) {
            await _canvas.Interop.UndoAsync( );
        }
    }

    private async Task RedoAsync( ) {
        if ( _canvas?.Interop is not null ) {
            await _canvas.Interop.RedoAsync( );
        }
    }

    private async Task ValidateDagAsync( ) {
        if ( IsNewMode ) return;
        _isValidating = true;
        _errorMessage = null;
        try {
            HttpResponseMessage response = await Api.PostAsync( $"/api/v1/workflows/{_workflowId}/validate", null );
            _dagResult = await response.Content.ReadFromJsonAsync<DagValidationResult>( );
        } catch ( Exception ex ) {
            _errorMessage = $"Validation failed: {ex.Message}";
        } finally {
            _isValidating = false;
        }
    }

    private async Task AutoLayoutAsync( ) {
        if ( _canvas?.Interop is not null ) {
            await _canvas.Interop.AutoLayoutAsync( );
        }
    }

    private async Task SetDirectionAsync( string direction ) {
        _direction = direction;
        if ( _canvas?.Interop is not null ) {
            await _canvas.Interop.SetLayoutDirectionAsync( direction );
        }
    }

    private async Task ZoomInAsync( ) {
        if ( _canvas?.Interop is not null ) {
            await _canvas.Interop.ZoomToAsync( _zoomLevel * 1.2 );
        }
    }

    private async Task ZoomOutAsync( ) {
        if ( _canvas?.Interop is not null ) {
            await _canvas.Interop.ZoomToAsync( _zoomLevel / 1.2 );
        }
    }

    private async Task ZoomFitAsync( ) {
        if ( _canvas?.Interop is not null ) {
            await _canvas.Interop.ZoomToFitAsync( );
        }
    }

    private async Task ExportSvgAsync( ) {
        if ( _canvas?.Interop is not null ) {
            await _canvas.Interop.ExportSvgAsync( );
        }
    }

    private async Task ExportPngAsync( ) {
        if ( _canvas?.Interop is not null ) {
            await _canvas.Interop.ExportPngAsync( );
        }
    }

    private async Task ToggleGridAsync( ) {
        _gridVisible = !_gridVisible;
        if ( _canvas?.Interop is not null ) {
            await _canvas.Interop.SetGridVisibleAsync( _gridVisible );
        }
    }

    private async Task AddAnnotationAsync( ) {
        if ( _canvas?.Interop is not null ) {
            _annotationCount++;
            double offsetX = 100 + ( ( _annotationCount - 1 ) * 30 );
            double offsetY = 100 + ( ( _annotationCount - 1 ) * 25 );
            await _canvas.Interop.AddAnnotationAsync( new {
                id = Guid.NewGuid().ToString( ),
                text = "New note",
                x = offsetX,
                y = offsetY,
                width = 200,
                height = 120,
                color = "#fef3cd",
            } );
        }
    }

    // ── Draft Management ──

    private async Task RestoreDraftAsync( ) {
        if ( _canvas?.Interop is not null ) {
            await _canvas.Interop.RestoreDraftAsync( _userId, _workflowId );
        }
        _draftDismissed = true;
    }

    private async Task DismissDraftAsync( ) {
        if ( _canvas?.Interop is not null ) {
            await _canvas.Interop.DismissDraftAsync( _userId, _workflowId );
        }
        _draftDismissed = true;
    }

    // ── Canvas Event Handlers ──

    private async Task HandleNodeSelectedAsync( long stepId ) {
        Logger.LogInformation( "[DagEditor] HandleNodeSelectedAsync stepId={StepId}", stepId );
        _selectedStepId = stepId;

        WorkflowStepDto? step = _workflow?.Steps.FirstOrDefault( s => s.Id == stepId );
        if ( step is not null ) {
            _selectedTaskId = step.TaskId ?? 0;
            _selectedTaskName = step.TaskName ?? $"Task #{step.TaskId ?? 0}";
            _selectedControlStatement = step.ControlStatement;
            _selectedConditionExpression = step.ConditionExpression;
            _selectedMaxIterations = step.MaxIterations;
            _selectedDependencyMode = step.DependencyMode;
            _selectedInputVariable = step.InputVariableName;
            _selectedOutputVariable = step.OutputVariableName;
            _selectedStepDependencies = step.Dependencies.Select( d => d.DependsOnStepId ).ToList( );
            _selectedIsComposite = step.IsComposite;
            _selectedCompositeType = step.CompositeType;
            _selectedChildWorkflowId = step.ChildWorkflowId;
            _selectedCollectionVariable = step.CollectionVariableName;
            _selectedIterationVariable = step.IterationVariableName;

            // Derive action key from the step's assigned task
            _selectedActionKey = step.TaskId.HasValue ? DeriveActionKeyFromTask( step.TaskId.Value ) : null;
        } else if ( _tempNodes.TryGetValue( stepId, out TempNodeState? ts ) ) {
            // Temp node — restore all state from C#-side tracking
            _selectedTaskId = ts.TaskId;
            _selectedTaskName = ts.TaskName;
            _selectedControlStatement = ts.ControlStatement;
            _selectedConditionExpression = ts.ConditionExpression;
            _selectedMaxIterations = ts.MaxIterations;
            _selectedDependencyMode = ts.DependencyMode;
            _selectedInputVariable = ts.InputVariableName;
            _selectedOutputVariable = ts.OutputVariableName;
            _selectedStepDependencies = [];
            _selectedIsComposite = ts.IsComposite;
            _selectedCompositeType = ts.CompositeType;
            _selectedChildWorkflowId = ts.ChildWorkflowId;
            _selectedCollectionVariable = ts.CollectionVariableName;
            _selectedIterationVariable = ts.IterationVariableName;
            _selectedActionKey = ts.ActionKey;
        } else {
            // Unknown node — shouldn't happen, but fall back to defaults
            _selectedTaskId = 0;
            _selectedTaskName = "";
            _selectedControlStatement = "Default";
            _selectedConditionExpression = null;
            _selectedMaxIterations = 100;
            _selectedDependencyMode = "AllSuccess";
            _selectedInputVariable = null;
            _selectedOutputVariable = null;
            _selectedStepDependencies = [];
            _selectedIsComposite = false;
            _selectedCompositeType = "None";
            _selectedChildWorkflowId = null;
            _selectedCollectionVariable = null;
            _selectedIterationVariable = null;
            _selectedActionKey = null;
        }

        await InvokeAsync( StateHasChanged );
    }

    private async Task HandleNodeDeselectedAsync( ) {
        Logger.LogInformation( "[DagEditor] HandleNodeDeselectedAsync" );
        _selectedStepId = null;
        _selectedActionKey = null;
        await InvokeAsync( StateHasChanged );
    }

    private async Task HandleNodeDroppedAsync( (string ActionType, double X, double Y) args ) {
        Logger.LogInformation( "[DagEditor] HandleNodeDroppedAsync actionType={ActionType} x={X} y={Y}", args.ActionType, args.X, args.Y );
        if ( _canvas?.Interop is null ) return;

        long tempId = _nextTempStepId--;
        _stepCount++;

        bool isComposite = args.ActionType.StartsWith( "composite:", StringComparison.Ordinal );
        string compositeType = isComposite ? args.ActionType["composite:".Length..] : "None";
        string? actionKey = isComposite ? null : args.ActionType;

        var data = new {
            stepId = tempId,
            stepLabel = isComposite ? $"{compositeType} (new)" : args.ActionType,
            taskName = isComposite ? compositeType : "Unassigned",
            controlStatement = "Default",
            order = _stepCount,
            taskId = 0,
            actionType = args.ActionType,
            isComposite,
            compositeType,
        };

        // Track all temp node state on the C# side
        _tempNodes[tempId] = new TempNodeState {
            IsComposite = isComposite,
            CompositeType = compositeType,
            ActionKey = actionKey,
        };

        await _canvas.Interop.AddNodeAsync( tempId, data, args.X, args.Y );

        // Select the new node so the config panel opens immediately.
        _selectedStepId = tempId;
        await ApplyTempNodeToSelection( _tempNodes[tempId] );

        await InvokeAsync( StateHasChanged );
    }

    private async Task HandleCycleDetectedAsync( (string SourceId, string TargetId) args ) {
        _errorMessage = $"Connection rejected: would create a cycle ({args.SourceId} → {args.TargetId}).";
        await InvokeAsync( StateHasChanged );
    }

    private async Task HandleDirtyCountChangedAsync( int dirtyCount ) {
        _dirtyCount = dirtyCount;
        await InvokeAsync( StateHasChanged );
    }

    private void HandleZoomChanged( double zoom ) {
        _zoomLevel = zoom;
        InvokeAsync( StateHasChanged );
    }

    // ── Palette Drag ──

    private async Task HandlePaletteDragStartAsync( (string ActionType, double ClientX, double ClientY) args ) {
        if ( _canvas?.Interop is not null ) {
            await _canvas.Interop.StartPaletteDragAsync( args.ActionType, args.ClientX, args.ClientY );
        }
    }

    private async Task HandleCompositeDragStartAsync( (string CompositeType, double ClientX, double ClientY) args ) {
        if ( _canvas?.Interop is not null ) {
            // Use a "composite:" prefix so the drop handler can distinguish composite nodes
            await _canvas.Interop.StartPaletteDragAsync( $"composite:{args.CompositeType}", args.ClientX, args.ClientY );
        }
    }

    // ── Config Panel ──

    private async Task HandleFieldChangedAsync( (string Field, object? Value) args ) {
        if ( _selectedStepId is null || _canvas?.Interop is null ) return;

        Dictionary<string, object?> fields = new( ) { [args.Field] = args.Value };
        await _canvas.Interop.UpdateNodeDataAsync( _selectedStepId.Value, fields );

        // Keep C#-side temp node state in sync
        if ( _tempNodes.TryGetValue( _selectedStepId.Value, out TempNodeState? ts ) ) {
            UpdateTempNodeField( ts, args.Field, args.Value );
        }
    }

    private Task HandleConfigPanelClose( ) {
        _selectedStepId = null;
        _selectedActionKey = null;
        StateHasChanged( );
        return Task.CompletedTask;
    }

    private async Task HandleDeleteSelectedAsync( ) {
        if ( _selectedStepId is null || _canvas?.Interop is null ) return;
        long stepId = _selectedStepId.Value;
        await _canvas.Interop.RemoveNodesAsync( [stepId] );
        _tempNodes.Remove( stepId );
        _selectedStepId = null;
        _selectedActionKey = null;
        StateHasChanged( );
    }

    private void HandleEditTaskAsync( ) {
        TaskDto? task = _tasks?.FirstOrDefault( t => t.Id == _selectedTaskId );
        if ( task is not null ) {
            _taskSetupModal?.Show( task );
        }
    }

    private void HandleCreateTaskAsync( ) {
        if ( !string.IsNullOrWhiteSpace( _selectedActionKey ) ) {
            _taskSetupModal?.Show( _selectedActionKey );
        } else {
            _taskSetupModal?.Show( );
        }
    }

    private async Task HandleRemoveDependencyAsync( long depStepId ) {
        // Removing a dependency updates the graph via JS changeset
        if ( _selectedStepId is null || _canvas?.Interop is null ) return;
        // The changeset tracks this — for now, rebuild the graph to reflect it
        await LoadAsync( );
    }

    // ── Task Modal Callbacks ──

    private async Task OnTaskCreatedAsync( TaskDto task ) {
        if ( _selectedStepId.HasValue && _canvas?.Interop is not null ) {
            await _canvas.Interop.UpdateNodeDataAsync( _selectedStepId.Value,
                new Dictionary<string, object?> { ["taskId"] = task.Id, ["taskName"] = task.Name } );

            // Track in temp node state
            if ( _tempNodes.TryGetValue( _selectedStepId.Value, out TempNodeState? ts ) ) {
                ts.TaskId = task.Id;
                ts.TaskName = task.Name;
            }
        }

        // Load tasks first so the dropdown option exists, then set the selection
        await LoadReferenceDataAsync( );
        _selectedTaskId = task.Id;
        _selectedTaskName = task.Name;
    }

    private async Task OnTaskUpdatedAsync( TaskDto task ) {
        await LoadReferenceDataAsync( );
        if ( _selectedTaskId == task.Id ) {
            _selectedTaskName = task.Name;
        }
    }

    /// <summary>Derives the action registry key from a task's ActionType/ActionSubType.</summary>
    private string? DeriveActionKeyFromTask( long taskId ) {
        TaskDto? task = _tasks?.FirstOrDefault( t => t.Id == taskId );
        if ( task is null ) return null;

        if ( task.ActionType == "Action" && !string.IsNullOrWhiteSpace( task.ActionSubType ) ) {
            return task.ActionSubType;
        }

        // For shell/PS types, use the ActionType directly as the key
        return ActionRegistry.Actions.ContainsKey( task.ActionType ) ? task.ActionType : null;
    }

    /// <summary>Copy temp node state into the selected-node fields for the config panel.</summary>
    private Task ApplyTempNodeToSelection( TempNodeState ts ) {
        _selectedTaskId = ts.TaskId;
        _selectedTaskName = ts.TaskName;
        _selectedControlStatement = ts.ControlStatement;
        _selectedConditionExpression = ts.ConditionExpression;
        _selectedMaxIterations = ts.MaxIterations;
        _selectedDependencyMode = ts.DependencyMode;
        _selectedInputVariable = ts.InputVariableName;
        _selectedOutputVariable = ts.OutputVariableName;
        _selectedStepDependencies = [];
        _selectedIsComposite = ts.IsComposite;
        _selectedCompositeType = ts.CompositeType;
        _selectedChildWorkflowId = ts.ChildWorkflowId;
        _selectedCollectionVariable = ts.CollectionVariableName;
        _selectedIterationVariable = ts.IterationVariableName;
        _selectedActionKey = ts.ActionKey;
        return Task.CompletedTask;
    }

    /// <summary>Update a single field on a temp node state from a config panel change.</summary>
    private static void UpdateTempNodeField( TempNodeState ts, string field, object? value ) {
        switch ( field ) {
            case "taskId": ts.TaskId = value is long l ? l : 0; break;
            case "taskName": ts.TaskName = value?.ToString( ) ?? ""; break;
            case "controlStatement": ts.ControlStatement = value?.ToString( ) ?? "Default"; break;
            case "conditionExpression": ts.ConditionExpression = value?.ToString( ); break;
            case "maxIterations": ts.MaxIterations = value is int i ? i : 100; break;
            case "dependencyMode": ts.DependencyMode = value?.ToString( ) ?? "AllSuccess"; break;
            case "inputVariableName": ts.InputVariableName = value?.ToString( ); break;
            case "outputVariableName": ts.OutputVariableName = value?.ToString( ); break;
            case "collectionVariableName": ts.CollectionVariableName = value?.ToString( ); break;
            case "iterationVariableName": ts.IterationVariableName = value?.ToString( ); break;
        }
    }

    // ── Models ──

    private sealed class WorkflowFormModel {
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public bool Enabled { get; set; } = true;
        public string[] TargetTags { get; set; } = [];
    }

    /// <summary>C#-side state for an unsaved temp node. Single source of truth for config panel values.</summary>
    private sealed class TempNodeState {
        public long TaskId { get; set; }
        public string TaskName { get; set; } = "";
        public string ControlStatement { get; set; } = "Default";
        public string? ConditionExpression { get; set; }
        public int MaxIterations { get; set; } = 100;
        public string DependencyMode { get; set; } = "AllSuccess";
        public string? InputVariableName { get; set; }
        public string? OutputVariableName { get; set; }
        public bool IsComposite { get; set; }
        public string CompositeType { get; set; } = "None";
        public long? ChildWorkflowId { get; set; }
        public string? CollectionVariableName { get; set; }
        public string? IterationVariableName { get; set; }
        public string? ActionKey { get; set; }
    }
}
