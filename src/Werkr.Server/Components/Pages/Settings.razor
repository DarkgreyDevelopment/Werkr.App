@page "/settings"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@using System.Runtime.InteropServices
@using System.Text.Json
@using Werkr.Common.Models
@attribute [Authorize( Roles = "Admin" )]
@rendermode InteractiveServer
@inject Werkr.Server.Services.ApiServiceAccessor Api
@inject IConfiguration Configuration
@inject IOptions<IdentityOptions> IdentityConfig

<PageTitle>Werkr - Settings</PageTitle>

<div class="container mt-4">
    <h1>Settings</h1>
    <Breadcrumb Items="_breadcrumbs" />

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "config" ? "active" : "")" @onclick='() => _activeTab = "config"'>Configuration</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "credentials" ? "active" : "")" @onclick="ActivateCredentialsTab">Credentials</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "diagnostics" ? "active" : "")" @onclick='() => _activeTab = "diagnostics"'>Diagnostics</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "tools" ? "active" : "")" @onclick='() => _activeTab = "tools"'>Tools</button>
        </li>
    </ul>

    @if ( !string.IsNullOrWhiteSpace( _errorMessage ) ) {
        <div class="alert alert-warning alert-dismissible">
            @_errorMessage
            <button type="button" class="btn-close" @onclick='() => _errorMessage = null'></button>
        </div>
    }

    @if ( !string.IsNullOrWhiteSpace( _successMessage ) ) {
        <div class="alert alert-success alert-dismissible">
            @_successMessage
            <button type="button" class="btn-close" @onclick='() => _successMessage = null'></button>
        </div>
    }

    @* ── Configuration Tab ── *@
    @if ( _activeTab == "config" ) {
        @* E3: Per-agent settings selector *@
        <div class="mb-3 d-flex gap-2 align-items-center">
            <select class="form-select" style="max-width: 200px;" @bind="_filterCategory">
                <option value="">All Categories</option>
                @foreach ( string cat in _categories ) {
                    <option value="@cat">@cat</option>
                }
            </select>
            <button class="btn btn-outline-secondary" @onclick="LoadConfigAsync" disabled="@_isLoading">
                @if ( _isLoading ) {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                Refresh
            </button>
            <div class="vr mx-2"></div>
            <label class="form-label mb-0 me-1 fw-bold text-nowrap">Agent View:</label>
            <select class="form-select" style="max-width: 240px;" @bind="_selectedAgentId" @bind:after="OnAgentSelectedAsync">
                <option value="">-- Global Settings --</option>
                @foreach ( AgentListDto agent in _agents ) {
                    <option value="@agent.Id">@agent.ConnectionName</option>
                }
            </select>
        </div>

        @if ( string.IsNullOrEmpty( _selectedAgentId ) ) {
            @* Global configuration table *@
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Key</th>
                            <th>Value</th>
                            <th>Type</th>
                            <th>Category</th>
                            <th style="width: 160px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach ( ConfigurationEntryDto entry in FilteredEntries ) {
                            <tr>
                                <td>
                                    <code>@entry.Key</code>
                                    @if ( !string.IsNullOrEmpty( entry.Description ) ) {
                                        <br /><small class="text-muted">@entry.Description</small>
                                    }
                                </td>
                                <td>
                                    @if ( _editingKey == entry.Key ) {
                                        <input class="form-control form-control-sm" @bind="_editValue" />
                                        @if ( !string.IsNullOrEmpty( GetValidationHint( entry ) ) ) {
                                            <small class="text-muted d-block mt-1">@GetValidationHint( entry )</small>
                                        }
                                    } else {
                                        <code>@entry.Value</code>
                                        @if ( entry.Value != entry.DefaultValue ) {
                                            <span class="badge bg-info ms-1" title="Modified from default">modified</span>
                                        }
                                    }
                                </td>
                                <td><span class="badge bg-secondary">@entry.ValueType</span></td>
                                <td>@entry.Category</td>
                                <td>
                                    @if ( _editingKey == entry.Key ) {
                                        <button class="btn btn-sm btn-success me-1" @onclick="() => PreviewSave( entry )">Save</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
                                    } else {
                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => StartEdit( entry )">Edit</button>
                                        <button class="btn btn-sm btn-outline-info" @onclick="() => ToggleHistoryAsync( entry.Key )">
                                            @( _historyKey == entry.Key ? "Hide" : "History" )
                                        </button>
                                    }
                                </td>
                            </tr>
                            @* E1: Collapsible history row *@
                            @if ( _historyKey == entry.Key ) {
                                <tr>
                                    <td colspan="5" class="bg-light">
                                        @if ( _historyEntries.Count == 0 ) {
                                            <small class="text-muted">No change history for this setting.</small>
                                        } else {
                                            <table class="table table-sm table-borderless mb-0">
                                                <thead>
                                                    <tr>
                                                        <th>Changed By</th>
                                                        <th>Changed (UTC)</th>
                                                        <th>Previous Value</th>
                                                        <th></th>
                                                        <th>New Value</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach ( ConfigurationChangeLogDto log in _historyEntries ) {
                                                        <tr>
                                                            <td><code>@log.ChangedByUserId</code></td>
                                                            <td><small>@log.ChangedUtc.ToString( "g" )</small></td>
                                                            <td><code>@(log.PreviousValue ?? "(none)")</code></td>
                                                            <td class="text-center">&rarr;</td>
                                                            <td><code>@log.NewValue</code></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        } else {
            @* E3: Per-agent effective settings table *@
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Key</th>
                            <th>Effective Value</th>
                            <th>Source</th>
                            <th>Global Value</th>
                            <th>Override Value</th>
                            <th>Type</th>
                            <th>Category</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach ( EffectiveConfigurationDto entry in FilteredAgentSettings ) {
                            <tr>
                                <td>
                                    <code>@entry.Key</code>
                                    @if ( !string.IsNullOrEmpty( entry.Description ) ) {
                                        <br /><small class="text-muted">@entry.Description</small>
                                    }
                                </td>
                                <td><code>@entry.EffectiveValue</code></td>
                                <td>
                                    @entry.Source
                                    @* E4: Override indication badge *@
                                    @if ( entry.Source == "Agent Override" ) {
                                        <span class="badge bg-warning ms-1">Override</span>
                                    }
                                </td>
                                <td><code>@entry.GlobalValue</code></td>
                                <td>
                                    @if ( entry.OverrideValue is not null ) {
                                        <code>@entry.OverrideValue</code>
                                    } else {
                                        <small class="text-muted">(none)</small>
                                    }
                                </td>
                                <td><span class="badge bg-secondary">@entry.ValueType</span></td>
                                <td>@entry.Category</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @* E2: Change preview modal *@
        @if ( _showPreviewModal ) {
            <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Confirm Setting Change</h5>
                            <button type="button" class="btn-close" @onclick="CancelPreview"></button>
                        </div>
                        <div class="modal-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-3">Key</dt>
                                <dd class="col-sm-9"><code>@_previewKey</code></dd>
                                <dt class="col-sm-3">Old Value</dt>
                                <dd class="col-sm-9"><code class="text-danger">@_previewOldValue</code></dd>
                                <dt class="col-sm-3">New Value</dt>
                                <dd class="col-sm-9"><code class="text-success">@_previewNewValue</code></dd>
                            </dl>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary" @onclick="CancelPreview">Cancel</button>
                            <button class="btn btn-primary" @onclick="ConfirmSaveAsync">Confirm</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    @* ── Credentials Tab ── *@
    @if ( _activeTab == "credentials" ) {
        <div class="mb-3">
            <button class="btn btn-primary" @onclick="() => _showCreateModal = true">New Credential</button>
            <button class="btn btn-outline-secondary ms-2" @onclick="LoadCredentialsAsync" disabled="@_isLoading">Refresh</button>
        </div>

        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Description</th>
                        <th>Agent Scopes</th>
                        <th>Modified</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach ( CredentialDto cred in _credentials ) {
                        <tr>
                            <td><code>@cred.Name</code></td>
                            <td><span class="badge bg-secondary">@cred.Type</span></td>
                            <td>@(cred.Description ?? "")</td>
                            <td>@(cred.AgentScopeIds.Count == 0 ? "All Agents" : $"{cred.AgentScopeIds.Count} agents")</td>
                            <td><small class="text-muted">@cred.ModifiedUtc.ToString("g")</small></td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => StartEditCredential( cred )">Edit</button>
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => StartRenameCredential( cred )">Rename</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCredentialAsync( cred )">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Create / Edit credential modal (with F2: agent scope selector) *@
        @if ( _showCreateModal ) {
            <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">@(_editCredentialId.HasValue ? "Edit Credential" : "New Credential")</h5>
                            <button type="button" class="btn-close" @onclick="CloseCredentialModal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label">Name</label>
                                <input class="form-control" @bind="_credName" disabled="@_editCredentialId.HasValue" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Type</label>
                                <select class="form-select" @bind="_credType">
                                    <option value="Password">Password</option>
                                    <option value="ApiKey">API Key</option>
                                    <option value="ConnectionString">Connection String</option>
                                    <option value="Certificate">Certificate</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Value</label>
                                <input type="password" class="form-control" @bind="_credValue"
                                       placeholder="@(_editCredentialId.HasValue ? "Leave blank to keep current" : "Enter credential value")" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Description</label>
                                <input class="form-control" @bind="_credDescription" />
                            </div>
                            @* F2: Agent scope selector *@
                            <div class="mb-3">
                                <label class="form-label fw-bold">Agent Scopes</label>
                                <small class="text-muted d-block mb-2">Leave all unchecked for "All Agents".</small>
                                @if ( _agentList.Count == 0 ) {
                                    <small class="text-muted">No agents registered.</small>
                                } else {
                                    <div class="border rounded p-2" style="max-height: 200px; overflow-y: auto;">
                                        @foreach ( AgentListDto agent in _agentList ) {
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="scope-@agent.Id"
                                                       checked="@_selectedAgentScopes.Contains( agent.Id )"
                                                       @onchange="( e ) => ToggleAgentScope( agent.Id, (bool)(e.Value ?? false) )" />
                                                <label class="form-check-label" for="scope-@agent.Id">
                                                    @agent.ConnectionName
                                                    <small class="text-muted">(@agent.Status)</small>
                                                </label>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary" @onclick="CloseCredentialModal">Cancel</button>
                            <button class="btn btn-primary" @onclick="SaveCredentialAsync">Save</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* F1: Rename credential modal *@
        @if ( _showRenameModal ) {
            <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Rename Credential</h5>
                            <button type="button" class="btn-close" @onclick="CloseRenameModal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label">Current Name</label>
                                <input class="form-control" value="@_renameOldName" disabled />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">New Name</label>
                                <input class="form-control" @bind="_renameNewName" />
                            </div>
                            <div class="alert alert-warning mb-0">
                                <strong>Warning:</strong> Renaming a credential will cascade updates to all tasks
                                that reference it by name. Verify that downstream task configurations are correct
                                after the rename completes.
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary" @onclick="CloseRenameModal">Cancel</button>
                            <button class="btn btn-primary" @onclick="ConfirmRenameAsync">Rename</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if ( _createdPlaintext is not null ) {
            <div class="alert alert-warning mt-3">
                <strong>Credential created.</strong> Copy the value now - it will not be shown again:
                <code class="d-block mt-1 p-2 bg-dark text-light rounded">@_createdPlaintext</code>
                <button class="btn btn-sm btn-outline-secondary mt-1" @onclick='() => _createdPlaintext = null'>Dismiss</button>
            </div>
        }
    }

    @* ── Diagnostics Tab ── *@
    @if ( _activeTab == "diagnostics" ) {
        <div class="mb-3">
            <button class="btn btn-outline-secondary" @onclick="LoadDiagnosticsAsync" disabled="@_isLoading">
                @if ( _isLoading ) {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                Refresh
            </button>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <h5 class="card-title">Identity Configuration</h5>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Min Password Length</dt>
                    <dd class="col-sm-8">@IdentityConfig.Value.Password.RequiredLength</dd>
                    <dt class="col-sm-4">Lockout Duration</dt>
                    <dd class="col-sm-8">@IdentityConfig.Value.Lockout.DefaultLockoutTimeSpan.TotalMinutes minutes</dd>
                    <dt class="col-sm-4">Max Failed Attempts</dt>
                    <dd class="col-sm-8">@IdentityConfig.Value.Lockout.MaxFailedAccessAttempts</dd>
                </dl>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <h5 class="card-title">Database Health</h5>
                @if ( _databaseHealth.Count == 0 ) {
                    <p class="text-muted mb-0">No database diagnostics available.</p>
                } else {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr><th>Context</th><th>Provider</th><th>Connected</th><th>Applied</th><th>Pending</th></tr>
                            </thead>
                            <tbody>
                                @foreach ( DatabaseHealthDto item in _databaseHealth ) {
                                    <tr>
                                        <td>@item.ContextName</td>
                                        <td>@item.ProviderName</td>
                                        <td><span class="badge @(item.IsConnected ? "bg-success" : "bg-danger")">@(item.IsConnected ? "Yes" : "No")</span></td>
                                        <td>@item.AppliedMigrationCount</td>
                                        <td>@item.PendingMigrationCount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <h5 class="card-title">Agent Health</h5>
                @if ( _agentHealth.Count == 0 ) {
                    <p class="text-muted mb-0">No agent health data available.</p>
                } else {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr><th>Agent Name</th><th>PowerShell</th><th>SystemShell</th><th>Status</th></tr>
                            </thead>
                            <tbody>
                                @foreach ( AgentHealthDto item in _agentHealth ) {
                                    <tr>
                                        <td>@item.ConnectionName</td>
                                        <td>@FormatNullableBoolean( item.PowerShellAvailable )</td>
                                        <td>@FormatNullableBoolean( item.SystemShellAvailable )</td>
                                        <td><span class="badge @StatusDisplayHelper.GetStatusBadgeClass( item.Status )">@item.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="card mt-3 mb-4">
            <div class="card-body">
                <h5 class="card-title">Infrastructure</h5>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Aspire Service Discovery</dt>
                    <dd class="col-sm-8">@( _serviceDiscoveryKeys.Count > 0 ? string.Join( ", ", _serviceDiscoveryKeys ) : "No services:* keys found" )</dd>
                    <dt class="col-sm-4">OTLP Endpoint</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace( _otlpEndpoint ) ? "Not configured" : _otlpEndpoint)</dd>
                    <dt class="col-sm-4">.NET Runtime</dt>
                    <dd class="col-sm-8">@Environment.Version</dd>
                    <dt class="col-sm-4">OS</dt>
                    <dd class="col-sm-8">@RuntimeInformation.OSDescription</dd>
                    <dt class="col-sm-4">Architecture</dt>
                    <dd class="col-sm-8">@RuntimeInformation.ProcessArchitecture</dd>
                </dl>
            </div>
        </div>
    }

    @* ── Tools Tab ── *@
    @if ( _activeTab == "tools" ) {
        <div class="card mt-3 mb-4">
            <div class="card-body">
                <h5 class="card-title">Notify Agents of Server URL Change</h5>
                <p class="text-muted">
                    If this Server's gRPC URL has changed, notify all connected Agents so they update
                    their stored endpoint and reconnect automatically.
                </p>
                <div class="mb-3" style="max-width: 480px;">
                    <label for="newServerUrl" class="form-label fw-bold">New Server URL</label>
                    <input id="newServerUrl" class="form-control" @bind="_notifyNewUrl"
                           placeholder="https://new-server-host:port" />
                </div>
                <button class="btn btn-warning" @onclick="NotifyUrlChangeAsync" disabled="@_isNotifying">
                    @if ( _isNotifying ) {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    Notify All Agents
                </button>

                @if ( _notifyResult is not null ) {
                    <div class="alert mt-3 @(_notifyResult.Failed > 0 ? "alert-warning" : "alert-success")">
                        <span><strong>@_notifyResult.Notified</strong> agents notified successfully.</span>
                        @if ( _notifyResult.Failed > 0 ) {
                            <br />
                            <span><strong>@_notifyResult.Failed</strong> agents failed:</span>
                            <span>@string.Join( ", ", _notifyResult.FailedAgents )</span>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private readonly List<Breadcrumb.BreadcrumbItem> _breadcrumbs = [
        new( "Task List", "/" ),
        new( "Settings" )
    ];

    private string _activeTab = "config";
    private string? _errorMessage;
    private string? _successMessage;
    private bool _isLoading;

    // Configuration state
    private List<ConfigurationEntryDto> _configEntries = [];
    private string _filterCategory = "";
    private string? _editingKey;
    private string _editValue = "";
    private string[] _categories = ["server", "agent", "workflow", "security", "network"];

    private IEnumerable<ConfigurationEntryDto> FilteredEntries =>
        string.IsNullOrEmpty( _filterCategory )
            ? _configEntries
            : _configEntries.Where( e => e.Category == _filterCategory );

    // E1: Change history state
    private string? _historyKey;
    private List<ConfigurationChangeLogDto> _historyEntries = [];

    // E2: Change preview state
    private bool _showPreviewModal;
    private string? _previewKey;
    private string _previewOldValue = "";
    private string _previewNewValue = "";

    // E3: Per-agent settings state
    private List<AgentListDto> _agents = [];
    private string? _selectedAgentId;
    private List<EffectiveConfigurationDto> _agentSettings = [];

    private IEnumerable<EffectiveConfigurationDto> FilteredAgentSettings =>
        string.IsNullOrEmpty( _filterCategory )
            ? _agentSettings
            : _agentSettings.Where( e => e.Category == _filterCategory );

    // Credential state
    private List<CredentialDto> _credentials = [];
    private bool _showCreateModal;
    private long? _editCredentialId;
    private string _credName = "";
    private string _credType = "Password";
    private string _credValue = "";
    private string _credDescription = "";
    private string? _createdPlaintext;

    // F1: Rename credential state
    private bool _showRenameModal;
    private long? _renameCredentialId;
    private string _renameOldName = "";
    private string _renameNewName = "";

    // F2: Agent scope selector state
    private List<AgentListDto> _agentList = [];
    private HashSet<Guid> _selectedAgentScopes = [];

    // Diagnostics state
    private List<DatabaseHealthDto> _databaseHealth = [];
    private List<AgentHealthDto> _agentHealth = [];
    private List<string> _serviceDiscoveryKeys = [];
    private string _otlpEndpoint = string.Empty;

    // URL notification state
    private string _notifyNewUrl = string.Empty;
    private bool _isNotifying;
    private NotifyUrlChangeResponse? _notifyResult;

    protected override async Task OnInitializedAsync( ) {
        LoadInfrastructureConfig( );
        await LoadAgentsAsync( );
        await LoadConfigAsync( );
        await LoadCredentialsAsync( );
    }

    // ── Agents (shared) ──

    private async Task LoadAgentsAsync( ) {
        try {
            _agents = await Api.GetAsync<List<AgentListDto>>( "/api/v1/agents" ) ?? [];
            _agentList = _agents;
        } catch ( Exception ex ) {
            _errorMessage = $"Failed to load agents: {ex.Message}";
        }
    }

    // ── Configuration ──

    private async Task LoadConfigAsync( ) {
        _isLoading = true;
        try {
            _configEntries = await Api.GetAsync<List<ConfigurationEntryDto>>( "/api/v1/settings" ) ?? [];
        } catch ( Exception ex ) {
            _errorMessage = $"Failed to load settings: {ex.Message}";
        } finally {
            _isLoading = false;
        }
    }

    private void StartEdit( ConfigurationEntryDto entry ) {
        _editingKey = entry.Key;
        _editValue = entry.Value;
    }

    private void CancelEdit( ) {
        _editingKey = null;
        _editValue = "";
    }

    // E2: Preview before committing
    private void PreviewSave( ConfigurationEntryDto entry ) {
        _previewKey = entry.Key;
        _previewOldValue = entry.Value;
        _previewNewValue = _editValue;
        _showPreviewModal = true;
    }

    private void CancelPreview( ) {
        _showPreviewModal = false;
        _previewKey = null;
        _previewOldValue = "";
        _previewNewValue = "";
    }

    private async Task ConfirmSaveAsync( ) {
        _showPreviewModal = false;
        if ( _previewKey is not null ) {
            await SaveSettingAsync( _previewKey );
        }
        _previewKey = null;
        _previewOldValue = "";
        _previewNewValue = "";
    }

    private async Task SaveSettingAsync( string key ) {
        try {
            ConfigurationUpdateRequest request = new( _editValue );
            HttpResponseMessage response = await Api.PutAsJsonAsync( $"/api/v1/settings/{key}", request );

            if (response.IsSuccessStatusCode) {
                _successMessage = $"Setting '{key}' updated.";
                _editingKey = null;
                await LoadConfigAsync( );
            } else {
                string body = await response.Content.ReadAsStringAsync( );
                _errorMessage = $"Failed to update: {body}";
            }
        } catch ( Exception ex ) {
            _errorMessage = $"Failed to update setting: {ex.Message}";
        }
    }

    // E1: Toggle history panel
    private async Task ToggleHistoryAsync( string key ) {
        if ( _historyKey == key ) {
            _historyKey = null;
            _historyEntries = [];
            return;
        }

        try {
            _historyEntries = await Api.GetAsync<List<ConfigurationChangeLogDto>>(
                $"/api/v1/settings/{key}/history" ) ?? [];
            _historyKey = key;
        } catch ( Exception ex ) {
            _errorMessage = $"Failed to load history: {ex.Message}";
        }
    }

    // E3: Per-agent settings
    private async Task OnAgentSelectedAsync( ) {
        if ( string.IsNullOrEmpty( _selectedAgentId ) ) {
            _agentSettings = [];
            return;
        }

        try {
            _agentSettings = await Api.GetAsync<List<EffectiveConfigurationDto>>(
                $"/api/v1/agents/{_selectedAgentId}/settings" ) ?? [];
        } catch ( Exception ex ) {
            _errorMessage = $"Failed to load agent settings: {ex.Message}";
        }
    }

    // E5: Validation hint helper
    private static string GetValidationHint( ConfigurationEntryDto entry ) {
        if ( string.IsNullOrWhiteSpace( entry.ValidationRules ) ) {
            return "";
        }

        try {
            using JsonDocument doc = JsonDocument.Parse( entry.ValidationRules );
            JsonElement root = doc.RootElement;
            List<string> parts = [];

            if ( root.TryGetProperty( "min", out JsonElement minEl ) ) {
                parts.Add( $"Min: {minEl}" );
            }
            if ( root.TryGetProperty( "max", out JsonElement maxEl ) ) {
                parts.Add( $"Max: {maxEl}" );
            }
            if ( root.TryGetProperty( "pattern", out JsonElement patternEl ) ) {
                parts.Add( $"Pattern: {patternEl.GetString()}" );
            }
            if ( root.TryGetProperty( "options", out JsonElement optionsEl )
                 && optionsEl.ValueKind == JsonValueKind.Array ) {
                List<string> options = [];
                foreach ( JsonElement item in optionsEl.EnumerateArray( ) ) {
                    options.Add( item.GetString( ) ?? item.ToString( ) );
                }
                parts.Add( $"Options: {string.Join( ", ", options )}" );
            }

            return parts.Count > 0 ? string.Join( " | ", parts ) : "";
        } catch {
            return "";
        }
    }

    // ── Credentials ──

    private async Task ActivateCredentialsTab( ) {
        _activeTab = "credentials";
        if ( _agentList.Count == 0 ) {
            await LoadAgentsAsync( );
        }
    }

    private async Task LoadCredentialsAsync( ) {
        try {
            _credentials = await Api.GetAsync<List<CredentialDto>>( "/api/v1/settings/credentials" ) ?? [];
        } catch ( Exception ex ) {
            _errorMessage = $"Failed to load credentials: {ex.Message}";
        }
    }

    private void StartEditCredential( CredentialDto cred ) {
        _editCredentialId = cred.Id;
        _credName = cred.Name;
        _credType = cred.Type;
        _credValue = "";
        _credDescription = cred.Description ?? "";
        _selectedAgentScopes = [.. cred.AgentScopeIds];
        _showCreateModal = true;
    }

    private void CloseCredentialModal( ) {
        _showCreateModal = false;
        _editCredentialId = null;
        _credName = "";
        _credType = "Password";
        _credValue = "";
        _credDescription = "";
        _selectedAgentScopes = [];
    }

    private async Task SaveCredentialAsync( ) {
        try {
            if (_editCredentialId.HasValue) {
                // Update credential value/description
                CredentialUpdateRequest request = new( _credValue, _credDescription, _credType );
                HttpResponseMessage response = await Api.PutAsJsonAsync(
                    $"/api/v1/settings/credentials/{_editCredentialId}", request );
                if (!response.IsSuccessStatusCode) {
                    _errorMessage = "Failed to update credential.";
                    return;
                }

                // F2: Update agent scopes
                CredentialScopeUpdateRequest scopeRequest = new( [.. _selectedAgentScopes] );
                HttpResponseMessage scopeResponse = await Api.PutAsJsonAsync(
                    $"/api/v1/settings/credentials/{_editCredentialId}/scope", scopeRequest );
                if (!scopeResponse.IsSuccessStatusCode) {
                    _errorMessage = "Credential updated but failed to update agent scopes.";
                    CloseCredentialModal( );
                    await LoadCredentialsAsync( );
                    return;
                }

                _successMessage = $"Credential '{_credName}' updated.";
            } else {
                // F2: Pass agent scopes in create request
                IReadOnlyList<Guid>? scopes = _selectedAgentScopes.Count > 0
                    ? [.. _selectedAgentScopes]
                    : null;
                CredentialCreateRequest request = new( _credName, _credType, _credValue, _credDescription, scopes );
                HttpResponseMessage response = await Api.PostAsJsonAsync( "/api/v1/settings/credentials", request );
                if (response.IsSuccessStatusCode) {
                    CredentialCreateResponse? created = await response.Content.ReadFromJsonAsync<CredentialCreateResponse>( );
                    _createdPlaintext = created?.PlaintextValue;
                    _successMessage = $"Credential '{_credName}' created.";
                } else {
                    _errorMessage = "Failed to create credential.";
                    return;
                }
            }

            CloseCredentialModal( );
            await LoadCredentialsAsync( );
        } catch ( Exception ex ) {
            _errorMessage = $"Credential operation failed: {ex.Message}";
        }
    }

    private async Task DeleteCredentialAsync( CredentialDto cred ) {
        try {
            HttpResponseMessage response = await Api.DeleteAsync( $"/api/v1/settings/credentials/{cred.Id}" );
            if (response.IsSuccessStatusCode) {
                _successMessage = $"Credential '{cred.Name}' deleted.";
                await LoadCredentialsAsync( );
            } else if ((int)response.StatusCode == 409) {
                string body = await response.Content.ReadAsStringAsync( );
                _errorMessage = $"Cannot delete: {body}";
            } else {
                _errorMessage = $"Failed to delete credential: {response.StatusCode}";
            }
        } catch ( Exception ex ) {
            _errorMessage = $"Failed to delete credential: {ex.Message}";
        }
    }

    // F1: Rename credential
    private void StartRenameCredential( CredentialDto cred ) {
        _renameCredentialId = cred.Id;
        _renameOldName = cred.Name;
        _renameNewName = "";
        _showRenameModal = true;
    }

    private void CloseRenameModal( ) {
        _showRenameModal = false;
        _renameCredentialId = null;
        _renameOldName = "";
        _renameNewName = "";
    }

    private async Task ConfirmRenameAsync( ) {
        if ( string.IsNullOrWhiteSpace( _renameNewName ) ) {
            _errorMessage = "New name cannot be empty.";
            return;
        }

        try {
            CredentialRenameRequest request = new( _renameNewName.Trim( ) );
            HttpResponseMessage response = await Api.PutAsJsonAsync(
                $"/api/v1/settings/credentials/{_renameCredentialId}/name", request );

            if ( response.IsSuccessStatusCode ) {
                _successMessage = $"Credential renamed from '{_renameOldName}' to '{_renameNewName.Trim()}'.";
                CloseRenameModal( );
                await LoadCredentialsAsync( );
            } else {
                string body = await response.Content.ReadAsStringAsync( );
                _errorMessage = $"Failed to rename credential: {body}";
            }
        } catch ( Exception ex ) {
            _errorMessage = $"Failed to rename credential: {ex.Message}";
        }
    }

    // F2: Toggle agent scope checkbox
    private void ToggleAgentScope( Guid agentId, bool isChecked ) {
        if ( isChecked ) {
            _ = _selectedAgentScopes.Add( agentId );
        } else {
            _ = _selectedAgentScopes.Remove( agentId );
        }
    }

    // ── Diagnostics ──

    private async Task LoadDiagnosticsAsync( ) {
        _isLoading = true;
        try {
            Task<List<DatabaseHealthDto>?> databaseTask = Api.GetAsync<List<DatabaseHealthDto>>( "/api/v1/diagnostics/health" );
            Task<List<AgentHealthDto>?> healthTask = Api.GetAsync<List<AgentHealthDto>>( "/api/v1/agents/health" );
            await Task.WhenAll( databaseTask, healthTask );
            _databaseHealth = await databaseTask ?? [];
            _agentHealth = await healthTask ?? [];
        } catch ( Exception ex ) {
            _errorMessage = $"Failed to load diagnostics: {ex.Message}";
        } finally {
            _isLoading = false;
        }
    }

    private void LoadInfrastructureConfig( ) {
        _serviceDiscoveryKeys = [.. Configuration.AsEnumerable( )
            .Where( kvp => !string.IsNullOrWhiteSpace( kvp.Key ) && kvp.Key.StartsWith( "services:", StringComparison.OrdinalIgnoreCase ) )
            .Select( kvp => kvp.Key )
            .Distinct( )
            .OrderBy( key => key )];

        _otlpEndpoint = Environment.GetEnvironmentVariable( "OTEL_EXPORTER_OTLP_ENDPOINT" ) ?? string.Empty;
    }

    private static string FormatNullableBoolean( bool? value ) =>
        value switch { true => "Yes", false => "No", null => "Unknown" };

    // ── URL Notification ──

    private async Task NotifyUrlChangeAsync( ) {
        if (string.IsNullOrWhiteSpace( _notifyNewUrl )) {
            _errorMessage = "Please enter the new server URL.";
            return;
        }

        _isNotifying = true;
        _notifyResult = null;
        _errorMessage = null;

        try {
            NotifyUrlChangeRequest request = new( _notifyNewUrl.Trim( ) );
            HttpResponseMessage response = await Api.PostAsJsonAsync( "/api/v1/settings/notify-url-change", request );

            if (response.IsSuccessStatusCode) {
                _notifyResult = await response.Content.ReadFromJsonAsync<NotifyUrlChangeResponse>( );
            } else {
                _errorMessage = $"Failed to send URL notification: {response.StatusCode}";
            }
        } catch (Exception ex) {
            _errorMessage = $"Failed to send URL notification: {ex.Message}";
        } finally {
            _isNotifying = false;
        }
    }
}
