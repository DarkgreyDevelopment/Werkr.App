@rendermode InteractiveServer

<div>
    @for ( int i = 0; i < _rows.Count; i++ ) {
        int index = i;
        <div class="input-group input-group-sm mb-1">
            <input type="text" class="form-control font-monospace"
                   placeholder="Key" style="max-width: 40%;"
                   value="@_rows[index].Key"
                   @onchange="( e ) => UpdateKey( index, e.Value?.ToString( ) ?? string.Empty )" />
            <input type="text" class="form-control font-monospace"
                   placeholder="Value"
                   value="@_rows[index].Value"
                   @onchange="( e ) => UpdateValue( index, e.Value?.ToString( ) ?? string.Empty )" />
            <button class="btn btn-outline-danger" type="button"
                    @onclick="( ) => RemoveRow( index )"
                    title="Remove pair">&times;</button>
        </div>
        @if ( _rows[index].IsDuplicate ) {
            <div class="text-warning small mb-1">Duplicate key: "@_rows[index].Key"</div>
        }
    }
    <button class="btn btn-outline-primary btn-sm mt-1" type="button" @onclick="AddRow">
        + Add Pair
    </button>
</div>

@code {
    /// <summary>The dictionary of key-value string pairs — two-way bound.</summary>
    [Parameter]
    public Dictionary<string, string>? Value { get; set; }

    /// <summary>Callback when the dictionary changes.</summary>
    [Parameter]
    public EventCallback<Dictionary<string, string>?> ValueChanged { get; set; }

    /// <summary>Indicates whether any duplicate keys exist in the current rows.</summary>
    public bool HasDuplicates => _rows.Any( r => r.IsDuplicate );

    private List<KvRow> _rows = [];

    protected override void OnParametersSet( ) {
        Dictionary<string, string> incoming = Value ?? [];
        List<KvRow> mapped = incoming.Select( kvp => new KvRow( kvp.Key, kvp.Value, false ) ).ToList( );

        if ( _rows.Count != mapped.Count
                || !_rows.Zip( mapped ).All( pair =>
                    pair.First.Key == pair.Second.Key && pair.First.Value == pair.Second.Value ) ) {
            _rows = mapped;
            RefreshDuplicates( );
        }
    }

    private async Task UpdateKey( int index, string key ) {
        if ( index >= 0 && index < _rows.Count ) {
            _rows[index] = _rows[index] with { Key = key };
            RefreshDuplicates( );
            await NotifyChanged( );
        }
    }

    private async Task UpdateValue( int index, string value ) {
        if ( index >= 0 && index < _rows.Count ) {
            _rows[index] = _rows[index] with { Value = value };
            await NotifyChanged( );
        }
    }

    private async Task RemoveRow( int index ) {
        if ( index >= 0 && index < _rows.Count ) {
            _rows.RemoveAt( index );
            RefreshDuplicates( );
            await NotifyChanged( );
        }
    }

    private async Task AddRow( ) {
        _rows.Add( new KvRow( "", "", false ) );
        await NotifyChanged( );
    }

    private void RefreshDuplicates( ) {
        HashSet<string> seen = new( StringComparer.OrdinalIgnoreCase );
        HashSet<string> dupes = new( StringComparer.OrdinalIgnoreCase );

        foreach ( KvRow row in _rows ) {
            if ( !string.IsNullOrWhiteSpace( row.Key ) && !seen.Add( row.Key ) ) {
                dupes.Add( row.Key );
            }
        }

        for ( int i = 0; i < _rows.Count; i++ ) {
            bool isDup = !string.IsNullOrWhiteSpace( _rows[i].Key ) && dupes.Contains( _rows[i].Key );
            if ( _rows[i].IsDuplicate != isDup ) {
                _rows[i] = _rows[i] with { IsDuplicate = isDup };
            }
        }
    }

    private async Task NotifyChanged( ) {
        Dictionary<string, string> result = new( StringComparer.OrdinalIgnoreCase );
        foreach ( KvRow row in _rows ) {
            if ( !string.IsNullOrWhiteSpace( row.Key ) ) {
                result[row.Key] = row.Value;
            }
        }
        Value = result.Count > 0 ? result : null;
        await ValueChanged.InvokeAsync( Value );
    }

    private sealed record KvRow( string Key, string Value, bool IsDuplicate );
}
