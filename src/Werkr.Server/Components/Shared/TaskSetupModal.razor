@rendermode InteractiveServer
@inject Werkr.Server.Services.ApiServiceAccessor Api

@if ( _isVisible ) {
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@( IsEditing ? "Edit Task" : LockedTitle )</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    @if ( !string.IsNullOrWhiteSpace( _errorMessage ) ) {
                        <div class="alert alert-danger">@_errorMessage</div>
                    }

                    <EditForm Model="_model" OnValidSubmit="SubmitAsync" FormName="TaskSetupModal">
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <InputText class="form-control" @bind-Value="_model.Name" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_model.Description" />
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Action Type</label>
                                @if ( _lockedActionKey is not null ) {
                                    <span class="form-control-plaintext">Action</span>
                                } else {
                                    <InputSelect class="form-select" @bind-Value="_model.ActionType">
                                        <option value="Action">Action</option>
                                        <option value="PowerShellCommand">PowerShell Command</option>
                                        <option value="PowerShellScript">PowerShell Script</option>
                                        <option value="ShellCommand">Shell Command</option>
                                        <option value="ShellScript">Shell Script</option>
                                    </InputSelect>
                                }
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Timeout (minutes)</label>
                                <InputNumber class="form-control" @bind-Value="_model.TimeoutMinutes" />
                            </div>
                        </div>

                        <div class="mb-3">
                            @if ( IsScriptType( _model.ActionType ) ) {
                                <label class="form-label">Script Path</label>
                                <InputText class="form-control font-monospace" @bind-Value="_model.Content" />
                            } else if ( _model.ActionType != "Action" ) {
                                <label class="form-label">Command</label>
                                <InputTextArea class="form-control font-monospace" rows="3" @bind-Value="_model.Content" />
                            }
                        </div>

                        @if ( _model.ActionType != "Action" ) {
                            <div class="mb-3">
                                <label class="form-label">Arguments</label>
                                <ArgumentListEditor @bind-Value="_model.Arguments" />
                            </div>
                        }

                        @if ( _model.ActionType == "Action" ) {
                            <div class="mb-3">
                                <label class="form-label">Action Parameters</label>
                                <ActionParameterEditor @ref="_actionEditor"
                                                       @bind-ActionSubType="_model.ActionSubType"
                                                       @bind-ActionParameters="_model.ActionParameters"
                                                       LockedAction="@_lockedActionKey" />
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Target Tags</label>
                            <TagInput Value="@_targetTags" ValueChanged="OnTargetTagsChanged"
                                      HideEmptyWarning="true" />
                            <div class="form-text">
                                Task-level tags override the parent workflow's targeting.
                                Leave empty to inherit tags from the workflow.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Success Criteria</label>
                            <SuccessCriteriaEditor @bind-Value="_model.SuccessCriteria" ActionType="@_model.ActionType" />
                        </div>

                        <div class="mb-3">
                            <ToggleSwitch @bind-Value="_model.Enabled" Label="Enabled" />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                @if ( _isSaving ) {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                }
                                @( IsEditing ? "Save Changes" : "Create Task" )
                            </button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="Close">Cancel</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public long WorkflowId { get; set; }

    [Parameter]
    public EventCallback<TaskDto> OnTaskCreated { get; set; }

    [Parameter]
    public EventCallback<TaskDto> OnTaskUpdated { get; set; }

    private bool _isVisible;
    private bool _isSaving;
    private string? _errorMessage;
    private ActionParameterEditor? _actionEditor;
    private string[] _targetTags = [];
    private TaskFormModel _model = new( );
    private long? _editTaskId;
    private string? _lockedActionKey;

    private bool IsEditing => _editTaskId is not null;

    private string LockedTitle => _lockedActionKey is not null
        && ActionRegistry.Actions.TryGetValue( _lockedActionKey, out ActionFormDescriptor? desc )
            ? $"New {desc.DisplayName} Task"
            : "Create New Task";

    public void Show( ) {
        _model = new TaskFormModel( );
        _targetTags = [];
        _editTaskId = null;
        _lockedActionKey = null;
        _isVisible = true;
        _isSaving = false;
        _errorMessage = null;
        StateHasChanged( );
    }

    public void Show( string actionKey ) {
        _model = new TaskFormModel { ActionType = "Action", ActionSubType = actionKey };
        _lockedActionKey = actionKey;
        _targetTags = [];
        _editTaskId = null;
        _isVisible = true;
        _isSaving = false;
        _errorMessage = null;
        StateHasChanged( );
    }

    public void Show( TaskDto existingTask ) {
        _model = TaskFormModel.FromDto( existingTask );
        _targetTags = existingTask.TargetTags ?? [];
        _editTaskId = existingTask.Id;
        _lockedActionKey = null;
        _isVisible = true;
        _isSaving = false;
        _errorMessage = null;
        StateHasChanged( );
    }

    private void Close( ) {
        _isVisible = false;
        _lockedActionKey = null;
        StateHasChanged( );
    }

    private async Task SubmitAsync( ) {
        if ( _model.ActionType == "Action" && _actionEditor is not null && !_actionEditor.Validate( ) ) {
            return;
        }
        _isSaving = true;
        _errorMessage = null;
        try {
            if ( IsEditing ) {
                TaskUpdateRequest request = _model.ToUpdateRequest( _targetTags );
                HttpResponseMessage response = await Api.PutAsJsonAsync( $"/api/v1/tasks/{_editTaskId}", request );
                if ( response.IsSuccessStatusCode ) {
                    TaskDto? updated = await response.Content.ReadFromJsonAsync<TaskDto>( );
                    _isVisible = false;
                    if ( updated is not null ) {
                        await OnTaskUpdated.InvokeAsync( updated );
                    }
                } else {
                    string body = await response.Content.ReadAsStringAsync( );
                    _errorMessage = $"Failed to update task: {body}";
                }
            } else {
                TaskCreateRequest request = _model.ToCreateRequest( WorkflowId, _targetTags );
                HttpResponseMessage response = await Api.PostAsJsonAsync( "/api/v1/tasks", request );
                if ( response.IsSuccessStatusCode ) {
                    TaskDto? created = await response.Content.ReadFromJsonAsync<TaskDto>( );
                    _isVisible = false;
                    if ( created is not null ) {
                        await OnTaskCreated.InvokeAsync( created );
                    }
                } else {
                    string body = await response.Content.ReadAsStringAsync( );
                    _errorMessage = $"Failed to create task: {body}";
                }
            }
        } catch ( Exception ex ) {
            _errorMessage = IsEditing
                ? $"Failed to update task: {ex.Message}"
                : $"Failed to create task: {ex.Message}";
        } finally {
            _isSaving = false;
        }
    }

    private static bool IsScriptType( string actionType ) =>
        actionType is "PowerShellScript" or "ShellScript";

    private void OnTargetTagsChanged( string[] tags ) {
        _targetTags = tags;
    }

    private sealed class TaskFormModel {
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public string ActionType { get; set; } = "Action";
        public string Content { get; set; } = "";
        public string? Arguments { get; set; }
        public bool Enabled { get; set; } = true;
        public long? TimeoutMinutes { get; set; }
        public string? SuccessCriteria { get; set; }
        public string ActionSubType { get; set; } = "";
        public string? ActionParameters { get; set; }

        public static TaskFormModel FromDto( TaskDto dto ) {
            return new TaskFormModel {
                Name = dto.Name,
                Description = dto.Description,
                ActionType = dto.ActionType,
                Content = dto.Content,
                Arguments = dto.Arguments is not null ? string.Join( "\n", dto.Arguments ) : null,
                Enabled = dto.Enabled,
                TimeoutMinutes = dto.TimeoutMinutes,
                SuccessCriteria = dto.SuccessCriteria,
                ActionSubType = dto.ActionSubType ?? "",
                ActionParameters = dto.ActionParameters,
            };
        }

        public TaskCreateRequest ToCreateRequest( long workflowId, string[] targetTags ) {
            string[]? args = string.IsNullOrWhiteSpace( Arguments )
                ? null
                : Arguments.Split( '\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries );

            return new TaskCreateRequest(
                Name: Name,
                Description: Description,
                ActionType: ActionType,
                Content: Content,
                Arguments: args,
                TargetTags: targetTags,
                Enabled: Enabled,
                TimeoutMinutes: TimeoutMinutes,
                SuccessCriteria: SuccessCriteria,
                WorkflowId: workflowId > 0 ? workflowId : null,
                ActionSubType: string.IsNullOrWhiteSpace( ActionSubType ) ? null : ActionSubType,
                ActionParameters: string.IsNullOrWhiteSpace( ActionParameters ) ? null : ActionParameters );
        }

        public TaskUpdateRequest ToUpdateRequest( string[] targetTags ) {
            string[]? args = string.IsNullOrWhiteSpace( Arguments )
                ? null
                : Arguments.Split( '\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries );

            return new TaskUpdateRequest(
                Name: Name,
                Description: Description,
                ActionType: ActionType,
                Content: Content,
                Arguments: args,
                TargetTags: targetTags,
                Enabled: Enabled,
                TimeoutMinutes: TimeoutMinutes,
                SuccessCriteria: SuccessCriteria,
                ActionSubType: string.IsNullOrWhiteSpace( ActionSubType ) ? null : ActionSubType,
                ActionParameters: string.IsNullOrWhiteSpace( ActionParameters ) ? null : ActionParameters );
        }
    }
}
