@* Live log viewer for workflow step output with auto-scroll. *@

<div class="log-viewer bg-dark text-light rounded p-2" style="max-height:500px;overflow-y:auto;font-family:monospace;font-size:0.8rem;" @ref="_logContainer">
    @if ( Lines is null || Lines.Count == 0 ) {
        <span class="text-muted">No log output yet.</span>
    } else {
        @for ( int i = 0; i < Lines.Count; i++ ) {
            <div class="log-line">
                <span class="text-muted me-2" style="user-select:none;">@( i + 1 )</span>@Lines[i]
            </div>
        }
    }
</div>

@code {
    /// <summary>Log lines to display. Updated externally via SignalR or polling.</summary>
    [Parameter] public IReadOnlyList<string>? Lines { get; set; }

    private ElementReference _logContainer;
}
