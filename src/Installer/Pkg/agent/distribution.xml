<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Werkr Agent</title>
    <organization>app.werkr</organization>
    <domains enable_localSystem="true"/>
    <options customize="never" require-scripts="true" rootVolumeOnly="true"/>

    <allowed-os-versions>
        <os-version min="15.0"/>
    </allowed-os-versions>

    <choices-outline>
        <line choice="default">
            <line choice="app.werkr.agent"/>
        </line>
    </choices-outline>

    <choice id="default"/>
    <choice id="app.werkr.agent"
            visible="false"
            title="Werkr Agent"
            description="Werkr task execution agent with gRPC and PowerShell">
        <pkg-ref id="app.werkr.agent"/>
    </choice>

    <pkg-ref id="app.werkr.agent"
             version="{{VERSION}}"
             onConclusion="none">app.werkr.agent.pkg</pkg-ref>
</installer-gui-script>
