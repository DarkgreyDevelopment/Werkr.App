<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Werkr.Agent</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Werkr.Tests.Agent" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Microsoft.PowerShell.SDK" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
  </ItemGroup>

  <ItemGroup>
    <!-- GrpcLogMsg.proto types are generated by Werkr.Core (GrpcServices="Both")
         and imported via ProjectReference. Only compile Registration.proto for the client stub. -->
    <Protobuf Include="..\Werkr.Api\Protos\Registration.proto" GrpcServices="Client" Link="Protos\Registration.proto" />
    <Protobuf Include="..\Werkr.Common\Protos\ScheduleSync.proto" GrpcServices="Client" Link="Protos\ScheduleSync.proto" />
    <Protobuf Include="..\Werkr.Common\Protos\ScheduleInvalidation.proto" GrpcServices="Server" Link="Protos\ScheduleInvalidation.proto" />
    <Protobuf Include="..\Werkr.Common\Protos\JobReport.proto" GrpcServices="Client" Link="Protos\JobReport.proto" />
    <Protobuf Include="..\Werkr.Common\Protos\OutputFetch.proto" GrpcServices="Server" Link="Protos\OutputFetch.proto" />
    <Protobuf Include="..\Werkr.Common\Protos\OutputStreaming.proto" GrpcServices="Client" Link="Protos\OutputStreaming.proto" />
    <!-- ConnectionManagement.proto types are generated by Werkr.Core (GrpcServices="Both")
         and imported via ProjectReference. -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Werkr.ServiceDefaults\Werkr.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Werkr.Common\Werkr.Common.csproj" />
    <ProjectReference Include="..\Werkr.Core\Werkr.Core.csproj" />
    <ProjectReference Include="..\Werkr.Data\Werkr.Data.csproj" />
  </ItemGroup>

</Project>
