{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Grpc": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/agent-log-.txt",
          "rollingInterval": "Day"
        }
      },
      { "Name": "OpenTelemetry" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Agent": {
    "Name": "Default Agent",
    "GrpcPort": 5100,
    "EnablePowerShell": true,
    "EnableSystemShell": true,
    "PowerShell": {
      "BufferWidth": 150
    }
  },
  "ConnectionStrings": {
    "AgentDb": "Data Source=werkr-agent.db"
  },
  "ActionOperator": {
    "DefaultTimeout": "01:00:00"
  },
  "AllowedHosts": "*"
}
